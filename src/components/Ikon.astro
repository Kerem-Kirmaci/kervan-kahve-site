// Dolu ikonlar: rozet ve durum işaretleri.
const dolu: Record<string, string> = {
  'yildiz': '<path d="m12 3.5 2.6 5.4 5.9.8-4.3 4.1 1 5.9-5.2-2.8-5.2 2.8 1-5.9L3.5 9.7l5.9-.8z"/>',
  'kalp': '<path d="M12 20.5C6.5 16.8 3.5 13.7 3.5 10.2A4.7 4.7 0 0 1 12 7.3a4.7 4.7 0 0 1 8.5 2.9c0 3.5-3 6.6-8.5 10.3Z"/>',
  'alev': '<path d="M13 2.5c.6 3-1.2 4.4-2.6 5.8C9 9.7 8 11 8 13.2a4.3 4.3 0 0 0 8.6.3c0-1.4-.5-2.5-1.2-3.5.2 1-.4 1.9-1.2 2.1.6-2.6-.4-6-1.2-9.6Z"/>',
};

const govde = cizgi[ad] ?? dolu[ad];
if (!govde) throw new Error(`Ikon: bilinmeyen ad"${ad}"`);
const cizgiMi = ad in cizgi;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={boyut}
  height={boyut}
  viewBox="0 0 24 24"
  class={sinif}
  fill={cizgiMi ? 'none' : 'currentColor'}
  stroke={cizgiMi ? 'currentColor' : 'none'}
  stroke-width={cizgiMi ? 1.7 : 0}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={govde}
/>
