---
/**
 * Sitedeki tek ikon sistemi.
 *
 * Öncesinde dört sistem yan yana duruyordu: Material Icons fontu (41 kullanım),
 * satır içi SVG (21), emoji (16) ve metne gömülü"→" karakteri. Font isteği de
 * kalktı — hepsi burada, currentColor ile çiziliyor.
 *
 * Kullanım:  <Ikon ad="ok-sag" />            (varsayılan 20px)
 *            <Ikon ad="kahve" boyut={32} />
 */
interface Props {
  ad: string;
  boyut?: number;
  sinif?: string;
}
const { ad, boyut = 20, sinif = '' } = Astro.props;

// Çizgi ikonlar: ortak stroke ayarlarını paylaşır.
const cizgi: Record<string, string> = {
