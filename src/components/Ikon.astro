  'chevron-sag': '<path d="M9.5 5.5 16 12l-6.5 6.5"/>',
  'ok-sag': '<path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>',
  'kapat': '<path d="M6 6l12 12"/><path d="M18 6 6 18"/>',
  'menu': '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
  'ara': '<circle cx="11" cy="11" r="6.5"/><path d="M20 20.5 15.6 16"/>',
  'buyutec': '<circle cx="11" cy="11" r="6.5"/><path d="M20 20.5 15.6 16"/><path d="M11 8.5v5"/><path d="M8.5 11h5"/>',
  'eposta': '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.6 6.6 7.3 5.2a2 2 0 0 0 2.2 0l7.3-5.2"/>',
  'telefon': '<path d="M21 16.5v2.6a1.9 1.9 0 0 1-2.1 1.9 18.6 18.6 0 0 1-8.1-2.9 18.3 18.3 0 0 1-5.6-5.6A18.6 18.6 0 0 1 2.3 4.4 1.9 1.9 0 0 1 4.2 2.3h2.6a1.9 1.9 0 0 1 1.9 1.6c.1.9.3 1.8.6 2.6a1.9 1.9 0 0 1-.4 2L7.7 9.6a15 15 0 0 0 5.6 5.6l1.2-1.2a1.9 1.9 0 0 1 2-.4c.8.3 1.7.5 2.6.6a1.9 1.9 0 0 1 1.6 1.9z"/>',
  'filtre': '<path d="M4 6.5h16"/><path d="M7 12h10"/><path d="M10 17.5h4"/>',
  'konum': '<path d="M12 21c4-4.2 6-7.6 6-10.3A6 6 0 0 0 6 10.7C6 13.4 8 16.8 12 21Z"/><circle cx="12" cy="10.5" r="2.3"/>',
  'instagram': '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M16.8 7.2h.01"/>',
  // Balon çizgi, içindeki ahize dolgulu — 22px'de çizgi ahize okunmuyordu.
  'whatsapp': '<path d="M12 3.2a8.6 8.6 0 0 0-7.4 13L3.4 20.6l4.5-1.2A8.6 8.6 0 1 0 12 3.2z"/><path d="M9.6 7.3c-.7.2-1.2.9-1.1 1.6a7.6 7.6 0 0 0 6.6 6.6c.7.1 1.4-.4 1.6-1.1l-2.2-1.3-1.1 1a6 6 0 0 1-3.5-3.5l1-1.1z" fill="currentColor" stroke-width="1"/>',
  'kontrol': '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  'ev': '<path d="M4 10.5 12 4l8 6.5V19a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 19Z"/><path d="M9.5 20.5v-6h5v6"/>',
  'canta': '<path d="M4.5 7.5h15l-1 12a2 2 0 0 1-2 1.9H7.5a2 2 0 0 1-2-1.9Z"/><path d="M8.5 10V6.5a3.5 3.5 0 0 1 7 0V10"/>',
  'is': '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7"/><path d="M3 12.5h18"/>',
  'bilgi': '<circle cx="12" cy="12" r="8.5"/><path d="M12 11v5.5"/><path d="M12 7.8h.01"/>',
  'hedef': '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1"/>',
  'goz': '<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="3.2"/>',
  'ampul': '<path d="M9.5 18.5h5"/><path d="M10 21.5h4"/><path d="M12 2.5a6 6 0 0 0-3.6 10.8c.6.5 1 1.2 1.1 2h5c.1-.8.5-1.5 1.1-2A6 6 0 0 0 12 2.5Z"/>',
  'yaprak': '<path d=\"M5 19c0-7 4.5-11.5 14-12 .5 8-3.5 13-9 13a5 5 0 0 1-5-1Z\"/><path d=\"M9.5 14.5 5 19\"/>',
  // Tabaklı fincan, buharsız. Gövde kutunun tam ortasında (x 4.5–18.5), kulp
  // sağa taşar. Göz kutuyu değil gövdeyi hizalar; gövde solda kalınca listede
  // yanındaki ikonlarla ortalı görünmüyordu.
  'kahve': '<path d="M4.5 5h14v6.5a5 5 0 0 1-5 5h-4a5 5 0 0 1-5-5Z"/><path d="M18.5 6.5h1a2.75 2.75 0 0 1 0 5.5h-1"/><path d="M5.5 19.5h12"/>',
  'cay': '<path d="M4.5 10h11v4.5a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5Z"/><path d="M15.5 11.5h2a2.2 2.2 0 0 1 0 4.4h-2"/><path d="M9 7.5c0-2 1.5-3 3-3.5-.2 2-1 3-3 3.5Z"/>',
  'surup': '<path d="M10 3.5h4v3l2.2 2.8a3 3 0 0 1 .6 1.8v7.4a2 2 0 0 1-2 2h-5.6a2 2 0 0 1-2-2v-7.4a3 3 0 0 1 .6-1.8L10 6.5Z"/><path d="M7.4 13h9.2"/>',
  'pure': '<path d="M6.5 8.5h11l-1 10a2 2 0 0 1-2 1.8h-5a2 2 0 0 1-2-1.8Z"/><path d="M6 4.5h12v4H6Z"/>',
  'pasta': '<path d="M4 20v-6a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v6Z"/><path d="M4 15.5c1.6 0 1.6 1.5 3.2 1.5s1.6-1.5 3.2-1.5 1.6 1.5 3.2 1.5 1.6-1.5 3.2-1.5 1.4 1.5 3 1.5"/><path d="M12 11V8"/><path d="M12 5.5V4"/>',
