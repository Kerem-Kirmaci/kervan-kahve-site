---
import Ikon from './Ikon.astro';

interface Props {
  /** Aktif sayfanın anahtarı */
  activePage?: string;
}

const { activePage } = Astro.props;

// Dört öğe. İletişim bilerek yok: mobil header'da zaten belirgin bir
// İletişim butonu duruyor, beşinci öğe hem onu tekrarlıyor hem 375px'te
// çubuğu taşırıyordu.
const items = [
  { key: 'index', href: '/index.html', ikon: 'ev', label: 'Ana Sayfa' },
  { key: 'shop', href: '/shop.html', ikon: 'canta', label: 'Ürünler' },
  { key: 'ortaklik', href: '/ortaklik.html', ikon: 'is', label: 'Ortaklık' },
  { key: 'hakkimizda', href: '/hakkimizda.html', ikon: 'bilgi', label: 'Hakkımızda' },
];
---

<nav class="bottom-nav" aria-label="Alt menü">
  <div class="flex justify-around px-1 py-1">
    {
      items.map((item) => {
        const isActive = activePage === item.key;
        return (
          <a
            href={item.href}
            class:list={[
              'flex flex-col items-center gap-1 flex-1 min-w-0 py-2 rounded transition-colors',
              isActive ? 'text-altin-koyu font-semibold' : 'text-is hover:text-murekkep',
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            <Ikon ad={item.ikon} boyut={22} />
            <span class="text-mini leading-none truncate max-w-full">{item.label}</span>
          </a>
        );
      })
    }
  </div>
</nav>
