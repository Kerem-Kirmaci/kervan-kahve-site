---
interface Props {
  /** Aktif sayfanın anahtarı */
  activePage?: string;
}

const { activePage } = Astro.props;

const items = [
  { key: 'index', href: '/index.html', icon: 'home', label: 'Ana Sayfa' },
  { key: 'shop', href: '/shop.html', icon: 'shopping_bag', label: 'Ürünler' },
  { key: 'ortaklik', href: '/ortaklik.html', icon: 'work', label: 'İş Ortaklığı' },
  { key: 'hakkimizda', href: '/hakkimizda.html', icon: 'info', label: 'Hakkımızda' },
];
---

<nav class="bottom-nav max-w-md mx-auto" aria-label="Alt menü">
  <div class="flex justify-around p-2">
    {
      items.map((item) => {
        const isActive = activePage === item.key;
        return (
          <a
            href={item.href}
            class:list={[
              'flex flex-col items-center py-2',
              isActive ? 'text-amber-700' : 'text-gray-600 hover:text-amber-700 transition-colors',
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            <span class="material-icons text-2xl" aria-hidden="true">{item.icon}</span>
            <span class="text-xs font-medium mt-1">{item.label}</span>
          </a>
        );
      })
    }
  </div>
</nav>
