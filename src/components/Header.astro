---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';

interface Props {
  /** Aktif sayfanın anahtarı: index | shop | ortaklik | hakkimizda | iletisim */
  activePage?: string;
}

const { activePage } = Astro.props;

const navItems = [
  { key: 'shop', href: '/shop.html', label: 'Ürünlerimiz' },
  { key: 'ortaklik', href: '/ortaklik.html', label: 'İş Ortaklığı' },
  { key: 'hakkimizda', href: '/hakkimizda.html', label: 'Hakkımızda' },
];

const mobileNavItems = [
  { key: 'index', href: '/index.html', label: 'Ana Sayfa' },
  ...navItems,
];

const isContactActive = activePage === 'iletisim';
import Ikon from './Ikon.astro';
---

<header
  class="sticky top-0 z-50 bg-kagit/90 backdrop-blur-lg border-b border-cizgi/60 mobile-simplified-header"
>
  <div class="container mx-auto px-4 py-3 flex justify-between items-center gap-3">
    <a
      href="/index.html"
      class="flex items-center gap-2 sm:gap-3 min-w-0 md:pr-6 md:border-r md:border-cizgi"
    >
      <Image
        src={logo}
        alt="Kervan Kahve Logo"
        width={128}
        height={128}
        class="h-10 sm:h-14 md:h-16 w-auto object-contain shrink-0"
        loading="eager"
      />
      <span class="hidden min-[360px]:inline text-kucuk sm:text-alt font-bold tracking-tight text-murekkep whitespace-nowrap" style="font-stretch: 112%">Kervan Kahve</span>
    </a>

    <nav class="hidden lg:flex items-center gap-2 desktop-nav" aria-label="Ana menü">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'nav-link inline-flex items-center h-11 px-3 text-govde font-semibold text-murekkep hover:text-altin-koyu rounded hover:bg-kum transition-colors',
              { active: activePage === item.key },
            ]}
            aria-current={activePage === item.key ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Arama çubuğu -->
    <div class="flex-1 max-w-md mx-2 md:mx-4 header-search-container">
      <div class="relative mobile-search-container">
        <Ikon ad="ara" sinif="absolute left-3 top-1/2 -translate-y-1/2 text-is pointer-events-none" />
        <form action="/shop.html" method="GET" role="search">
          <label for="global-search" class="sr-only">Ürün ara</label>
          <input
            id="global-search"
            name="search"
            type="search"
            placeholder="Ürün ara..."
            class="w-full h-11 pl-10 pr-4 rounded-tam border border-cizgi bg-kum text-murekkep placeholder-is text-kucuk focus:border-kabuk focus:bg-kagit transition-colors mobile-search-bar"
            style="-webkit-appearance: none; appearance: none;"
          />
        </form>
      </div>
    </div>

    {/* Tek İletişim butonu. Eskiden masaüstü ve mobil için iki ayrı öğe vardı
        ve renkleri farklıydı (amber-700 / brand-bg); tablet boyutunda da
        etiketini kaybedip anlamsız bir daireye dönüşüyordu. */}
    <a
      href="/iletisim.html"
      class:list={[
        'flex items-center justify-center gap-2 shrink-0 h-11 px-3 sm:px-4 rounded-tam',
        'bg-kabuk text-krem font-semibold text-kucuk whitespace-nowrap',
        'hover:bg-kavurma transition-colors',
      ]}
      aria-current={isContactActive ? 'page' : undefined}
    >
      <Ikon ad="eposta" boyut={18} />
      <span>İletişim</span>
    </a>

    {/* Menü butonu. Öncesinde `hidden md:block lg:hidden` idi: telefonda
        gizliydi, çünkü gezinme alttaki sabit çubukla yapılıyordu. O çubuk
        her ekranda 80px yer kaplıyor ve zaten bu menüdeki bağlantıların
        aynısını taşıyordu; kaldırıldı, menü butonu telefona indi. */}
    <button
      id="mobile-menu-btn"
      type="button"
      class="lg:hidden p-2 -mr-1 text-murekkep hover:text-kabuk transition-colors"
      aria-label="Menüyü aç"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span id="hamburger-icon"><Ikon ad="menu" boyut={24} /></span>
      <span id="close-icon" class="hidden"><Ikon ad="kapat" boyut={24} /></span>
    </button>
  </div>

</header>

{/* Mobil menü ve arka planı bilerek <header> DIŞINDA.
    Header'da `backdrop-blur` var; backdrop-filter, sabit konumlu alt öğeler
    için kapsayıcı blok yaratıyor. İçeride kaldıklarında `inset: 0` viewport'a
    değil header kutusuna göre çözülüyor ve panel 320x88px'e sıkışıyordu —
    menüdeki bağlantıların hepsi kesiliyordu. */}
  <!-- Mobil menü arka planı -->
  <div id="mobile-menu-overlay" class="mobile-menu-overlay fixed inset-0 bg-kavurma/75 z-40 lg:hidden"></div>

  <!-- Mobil menü.
       Dıştaki kabuk viewport'u tam kaplar ve overflow:hidden ile paneli kırpar.
       Panel kapalıyken ekranın 320px sağında durur; kabuk olmadan bu, sayfada
       yatay kaydırma yaratıyordu (eskiden html/body'ye overflow-x:hidden
       konarak bastırılmıştı). -->
  <div class="mobile-menu-shell lg:hidden">
    <div
      id="mobile-menu"
      class="mobile-menu"
      role="dialog"
      aria-modal="true"
      aria-label="Mobil menü"
    >
    <div class="h-full overflow-y-auto">
      <div class="bg-kagit p-6 border-b border-cizgi">
        <div class="flex justify-between items-center">
          <h3 class="text-alt font-bold text-murekkep">Menü</h3>
          <button
            id="mobile-menu-close"
            type="button"
            class="p-2 text-is hover:text-murekkep hover:bg-kum transition-all rounded-tam"
            aria-label="Menüyü kapat"
          >
            <Ikon ad="kapat" boyut={24} />
          </button>
        </div>
      </div>

      <nav class="p-6" aria-label="Mobil menü">
        <div class="space-y-3">
          {
            mobileNavItems.map((item) => {
              const isActive = activePage === item.key;
              return (
                <a
                  href={item.href}
                  class:list={[
                    'group flex items-center gap-3 p-3 rounded transition-all duration-200',
                    isActive ? 'bg-kum hover:bg-kum' : 'hover:bg-kum',
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  <span
                    class:list={[
                      'text-govde font-medium',
                      isActive ? 'text-altin-koyu' : 'text-murekkep group-hover:text-altin-koyu',
                    ]}
                  >
                    {item.label}
                  </span>
                </a>
              );
            })
          }
        </div>

        <div class="mt-8 pt-6 border-t border-cizgi">
          <a
            href="/iletisim.html"
            class="group flex items-center justify-center gap-3 p-4 rounded bg-kagit transition-all duration-300 border border-cizgi"
            aria-current={isContactActive ? 'page' : undefined}
          >
            <Ikon ad="eposta" boyut={18} />
            <span class="text-govde font-semibold text-altin-koyu">İletişim</span>
          </a>
        </div>
        </nav>
      </div>
    </div>
  </div>
