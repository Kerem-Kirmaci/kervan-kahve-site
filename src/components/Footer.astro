---
const year = new Date().getFullYear();

const quickLinks = [
  { href: '/index.html', label: 'Ana Sayfa' },
  { href: '/shop.html', label: 'Ürünlerimiz' },
  { href: '/ortaklik.html', label: 'İş Ortaklığı' },
  { href: '/hakkimizda.html', label: 'Hakkımızda' },
  { href: '/iletisim.html', label: 'İletişim' },
];

const legalLinks = [
  { href: '/gizlilik-politikasi.html', label: 'Gizlilik Politikası' },
  { href: '/cerez-politikasi.html', label: 'Çerez Politikası' },
  { href: '/kullanim-sartlari.html', label: 'Kullanım Şartları' },
];
import Ikon from './Ikon.astro';
---

<footer class="bg-kavurma text-krem border-t border-cizgi-koyu">
  <div class="container mx-auto px-6 py-12">
    <div class="grid lg:grid-cols-4 md:grid-cols-2 gap-8">
      <div>
        <h3 class="text-govde font-bold">Kervan Kahve</h3>
        {/* Her sayfanın altında duruyor, yani sitenin genel iddiası burada.
            Öncesinde "nitelikli kahve çekirdeklerini tutkuyla kavuruyor,
            işletmelere ve kahve severlere ulaştırıyoruz" yazıyordu: ana
            sayfanın söylediğiyle aynı şeyi söylemiyordu ve doğrulanmamış bir
            kavurma iddiası taşıyordu. */}
        <p class="mt-4 text-kucuk text-krem-ikincil">
          Mersin ve çevresinde kafe, restoran ve otellere tedarik yapıyoruz:
          kahve, şurup, püre, tatlı, bitki çayı ve ekipman.
        </p>
      </div>

      <div>
        <h3 class="text-govde font-bold">Hızlı Erişim</h3>
        <ul class="mt-4 space-y-2 text-kucuk">
          {quickLinks.map((l) => (
            <li><a href={l.href} class="text-krem-ikincil hover:text-krem">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-govde font-bold">Yasal</h3>
        <ul class="mt-4 space-y-2 text-kucuk">
          {legalLinks.map((l) => (
            <li><a href={l.href} class="text-krem-ikincil hover:text-krem">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-govde font-bold">Bize Ulaşın</h3>
        <ul class="mt-4 space-y-2 text-kucuk">
          <li>
            <a href="mailto:info@kervankahve.com" class="text-krem-ikincil hover:text-krem"
              >info@kervankahve.com</a
            >
          </li>
          <li>
            <a href="tel:+905453207713" class="text-krem-ikincil hover:text-krem">+90 545 320 77 13</a>
          </li>
          <li>
            <div class="flex space-x-4 mt-2">
              <a
                href="https://www.instagram.com/kervankahvetr/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-krem-ikincil hover:text-krem"
                aria-label="Kervan Kahve Instagram sayfası"
              >
                <Ikon ad="instagram" boyut={20} />
              </a>
            </div>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-cizgi-koyu text-center text-kucuk text-krem-ikincil">
      <p>&copy; {year} Kervan Kahve. Tüm hakları saklıdır.</p>
    </div>
  </div>
</footer>
