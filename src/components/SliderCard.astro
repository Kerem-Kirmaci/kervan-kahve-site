---
import { Image, getImage } from 'astro:assets';
import { productImage } from '../data/product-images.js';

interface Props {
  product: Record<string, any>;
  /** 'mobil' ve 'masaustu' arasındaki tek fark ürün adının punto boyutu */
  variant?: 'mobil' | 'masaustu';
  /** Slider içindeki sırası — kademeli giriş animasyonu için */
  index?: number;
}

const { product, variant = 'masaustu', index = 0 } = Astro.props;

const animationDelay = `${Math.min(index, 8) * 0.05}s`;

const img = productImage(product.image);
const large = await getImage({ src: img, width: 900, format: 'webp', quality: 78 });

const imageAlt = `${product.name} - ${product.description}`;
const hasBrandSplit = Boolean(product.brand && product.productName);

// Eski kodda createMobileSliderCard ve createDesktopSliderCard neredeyse birebir
// aynıydı; aralarındaki tek fark ürün adındaki bu text-sm sınıfıydı.
const nameSize = variant === 'masaustu' ? ' text-sm' : '';
---

<div
  class="flex-shrink-0 w-40 fade-in"
  style={`animation-delay: ${animationDelay}`}
  data-product-id={product.id}
>
  <div class="zoom-icon-wrapper">
    <Image
      src={img}
      alt={imageAlt}
      width={320}
      class="w-full h-40 object-cover rounded-lg shadow-md zoomable-image"
      loading="lazy"
      data-lightbox-src={large.src}
      data-lightbox-name={hasBrandSplit ? product.productName : product.name}
      data-lightbox-brand={product.brand ?? ''}
    />
    <span class="zoom-icon" aria-hidden="true">
      <span class="material-icons">zoom_in</span>
    </span>
  </div>
  {
    hasBrandSplit ? (
      <>
        <p class="mt-2 text-sm text-amber-700 font-semibold tracking-wide uppercase">
          {product.brand}
        </p>
        <p class={`font-medium text-gray-900${nameSize} leading-tight`}>{product.productName}</p>
      </>
    ) : (
      <p class={`mt-2 font-medium text-gray-900${nameSize}`}>{product.name}</p>
    )
  }
</div>
