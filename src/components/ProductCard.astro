---
import { Image, getImage } from 'astro:assets';
import { productImage } from '../data/product-images.js';

interface Props {
  product: Record<string, any>;
  /** Kartın ilk ekranda mı yoksa aşağıda mı olduğu — lazy yükleme kararı için */
  eager?: boolean;
  /** Başlangıçta gizli mi (kaydırdıkça açılan partiler için) */
  hidden?: boolean;
  /** Izgaradaki sırası — kademeli giriş animasyonu için */
  index?: number;
}

const { product, eager = false, hidden = false, index = 0 } = Astro.props;

// Kademeli giriş animasyonu. Eski kodda gecikme index * 0.1s idi; 100 ürünle
// son kart 10 saniye sonra beliriyordu. Gecikme 8 kartta sınırlanıyor.
const animationDelay = `${Math.min(index, 8) * 0.05}s`;

const img = productImage(product.image);

// Lightbox için daha büyük bir sürüm; kart görselini büyütünce bulanık görünmesin
const large = await getImage({ src: img, width: 900, format: 'webp', quality: 78 });

const imageAlt = `${product.name} - ${product.description}`;

// Marka ve ürün adı ayrı satırlarda gösterilir; ikisi de yoksa tam ada düşülür
const hasBrandSplit = Boolean(product.brand && product.productName);
const tags = (product.tastingNotes ?? []).slice(0, 3);

// İstemci tarafı aramanın tarayacağı metin. Eski filterProducts() ile aynı
// alanlara bakar: ad, açıklama, tat notaları ve (çaylarda) faydalar.
const searchText = [
  product.name,
  product.description,
  ...(product.tastingNotes ?? []),
  ...(product.healthBenefits ?? []),
]
  .join(' ')
  .toLowerCase();
---

<div
  class:list={['modern-product-card', 'fade-in', { 'product-hidden': hidden }]}
  style={`animation-delay: ${animationDelay}`}
  data-product-id={product.id}
  data-category={product.category}
  data-search={searchText}
>
  <div class="card-image zoom-icon-wrapper">
    <Image
      src={img}
      alt={imageAlt}
      width={400}
      class="zoomable-image"
      loading={eager ? 'eager' : 'lazy'}
      data-lightbox-src={large.src}
      data-lightbox-name={hasBrandSplit ? product.productName : product.name}
      data-lightbox-brand={product.brand ?? ''}
    />
    <span class="zoom-icon" aria-hidden="true">
      <span class="material-icons">zoom_in</span>
    </span>
  </div>
  <div class="card-content">
    {hasBrandSplit && <span class="card-brand">{product.brand}</span>}
    <h3 class="card-title">{hasBrandSplit ? product.productName : product.name}</h3>
    <p class="card-description">{product.description}</p>
    {
      tags.length > 0 && (
        <div class="card-tags">
          {tags.map((note: string) => (
            <span class="card-tag">{note}</span>
          ))}
        </div>
      )
    }
  </div>
</div>

<style>
  /* Modern ürün kartı — eskiden shop.html'in içinde inline duruyordu */
  .modern-product-card {
    background: white;
    border-radius: 12px;
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 2px 4px -1px rgba(0, 0, 0, 0.06);
    overflow: hidden;
    transform: translateY(0);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .modern-product-card:hover {
    transform: translateY(-8px);
    box-shadow:
      0 20px 25px -5px rgba(0, 0, 0, 0.1),
      0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }

  .modern-product-card .card-image {
    height: 200px;
    background: #f3f4f6;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modern-product-card .card-image :global(img) {
    height: 100%;
    width: 100%;
    object-fit: contain;
    padding: 0.5rem;
  }

  .modern-product-card .card-content {
    padding: 0.75rem 1rem;
    text-align: center;
  }

  .modern-product-card .card-brand {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    color: #b45309;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.125rem;
  }

  .modern-product-card .card-title {
    font-size: 1rem;
    font-weight: 700;
    color: #1f2937;
    margin-bottom: 0.375rem;
    line-height: 1.3;
  }

  /* Açıklama ekranda gösterilmiyor ama arama ve ekran okuyucular için duruyor */
  .modern-product-card .card-description {
    display: none;
  }

  .modern-product-card .card-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.375rem;
  }

  .modern-product-card .card-tag {
    background: rgba(245, 158, 11, 0.1);
    color: #f59e0b;
    font-size: 0.65rem;
    font-weight: 500;
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
  }

  /* Mobilde 2 sütunlu kompakt görünüm */
  @media (max-width: 640px) {
    .modern-product-card {
      border-radius: 10px;
    }

    .modern-product-card .card-image {
      height: 140px;
    }

    .modern-product-card .card-content {
      padding: 0.5rem 0.5rem 0.625rem;
    }

    .modern-product-card .card-brand {
      font-size: 0.6rem;
      letter-spacing: 0.03em;
      margin-bottom: 0.125rem;
    }

    .modern-product-card .card-title {
      font-size: 0.75rem;
      margin-bottom: 0.375rem;
      line-height: 1.25;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .modern-product-card .card-tags {
      display: flex;
      gap: 0.25rem;
    }

    .modern-product-card .card-tag {
      font-size: 0.6rem;
      padding: 0.125rem 0.375rem;
    }
  }
</style>
