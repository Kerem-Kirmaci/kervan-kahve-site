---
import Base from '../layouts/Base.astro';
import UrunKarti from '../components/UrunKarti.astro';
import Lightbox from '../components/Lightbox.astro';
import { products } from '../data/products.js';
import { getImage } from 'astro:assets';
import { productImage } from '../data/product-images.js';

// Mağaza sıralaması: Şurup → Püre → Tatlı → Kahve → Çay → Aksesuar,
// aynı kategoride önce öne çıkanlar, sonra ada göre Türkçe alfabetik.
// Eskiden bu sıralama her sayfa açılışında tarayıcıda yapılıyordu; artık
// build sırasında bir kez yapılıp HTML'e sabitleniyor.
const categoryOrder = ['surup', 'pure-tatlandirici', 'tatli', 'espresso', 'cay', 'aksesuar'];
const orderIndex = (key: string) => {
  const i = categoryOrder.indexOf(key);
  return i === -1 ? Number.MAX_SAFE_INTEGER : i;
};

const sorted = [...products].sort((a, b) => {
  const byCategory = orderIndex(a.category) - orderIndex(b.category);
  if (byCategory !== 0) return byCategory;
  const byFeatured = (b.featured ? 1 : 0) - (a.featured ? 1 : 0);
  if (byFeatured !== 0) return byFeatured;
  return a.name.localeCompare(b.name, 'tr', { sensitivity: 'base' });
});

// İlk parti kaç ürün görünür başlasın (kalanı kaydırdıkça açılır)
const INITIAL_VISIBLE = 24;

// Kategori sekmeleri. Sayılar veriden hesaplanıyor — ürün eklendiğinde
// kendiliğinden güncellenir.
const kategoriTanimlari = [
  { key: 'surup', label: 'Şuruplar' },
  { key: 'pure-tatlandirici', label: 'Püre ve Tatlandırıcılar' },
  { key: 'tatli', label: 'Tatlılar' },
  { key: 'espresso', label: 'Kahveler' },
  { key: 'cay', label: 'Bitki Çayları' },
  { key: 'aksesuar', label: 'Ekipmanlar' },
];

const sekmeler = [
  { key: '', label: 'Tümü', adet: sorted.length },
  ...kategoriTanimlari.map((k) => ({
    ...k,
    adet: sorted.filter((p) => p.category === k.key).length,
  })),
];

// Ürün kataloğu yapılandırılmış verisi (arama motorları için).
// Görsel yolları UrunKarti'nın lightbox sürümüyle birebir aynı parametrelerle
// üretiliyor (900px webp, kalite 78); Astro aynı dosyayı yeniden üretmiyor.
const yapisalGorseller = await Promise.all(
  sorted.map(async (p) => {
    const img = await getImage({
      src: productImage(p.image),
      width: 900,
      format: 'webp',
      quality: 78,
    });
    // Yapısal veri mutlak adres ister
    return new URL(img.src, Astro.site).href;
  })
);

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Kervan Kahve Ürünleri',
  url: 'https://kervankahve.com/shop.html',
  description: 'Kahve, şurup, püre ve tatlandırıcı, hazır tatlı, bitki çayı ve kahve ekipmanı',
  numberOfItems: sorted.length,
  itemListElement: sorted.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: p.name,
      description: p.description,
      image: yapisalGorseller[i],
      brand: { '@type': 'Brand', name: p.brand },
    },
  })),
};
import Ikon from '../components/Ikon.astro';
---

<Base
  title="Ürünlerimiz — Kervan Kahve"
  description={`Kafe, restoran ve otellere toptan tedarik ettiğimiz ${sorted.length} ürün: kahve, şurup, püre ve tatlandırıcı, hazır tatlı, bitki çayı ve ekipman.`}
  activePage="shop"
  mainClass="container mx-auto px-6 py-12"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(itemList)} />

  <Lightbox />

  <div class="mb-6 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
    <div>
      <h1 class="text-buyuk font-bold text-murekkep">Ürünlerimiz</h1>
      <p id="product-count" class="mt-2 text-govde text-is" aria-live="polite">
        {sorted.length} ürün bulundu
      </p>
    </div>

    <div class="relative w-full md:w-72 shrink-0">
      <Ikon ad="ara" boyut={18} sinif="absolute left-3 top-1/2 -translate-y-1/2 text-is pointer-events-none" />
      <label for="product-search" class="sr-only">Ürün ara</label>
      <input type="search" id="product-search" placeholder="Ürün ara..." class="form-alan form-alan--aramali" />
    </div>
  </div>

  {/* Kategori sekmeleri.
      Öncesinde soldaki kenar çubuğunda onay kutuları vardı; sayfanın dörtte
      birini altı onay kutusu için harcıyor, mobilde de tamamen ayrı bir
      çekmece bileşenine dönüşüyordu. Sekmeler her genişlikte aynı çalışıyor
      ve kaydırırken üstte kalıyor. */}
  <div class="kategori-serit-sarmal">
    <div class="kategori-sekmeler" role="tablist" aria-label="Ürün kategorileri">
      {
        sekmeler.map((k) => (
          <button
            type="button"
            role="tab"
            class="kategori-sekme"
            data-category={k.key}
            aria-selected={k.key === '' ? 'true' : 'false'}
          >
            <span>{k.label}</span>
            <span class="kategori-adet">{k.adet}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div
    id="product-grid"
        class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 sm:gap-4 md:gap-5"
        data-initial-visible={INITIAL_VISIBLE}
      >
        {
          sorted.map((product, i) => (
            <UrunKarti product={product} eager={i < 6} hidden={i >= INITIAL_VISIBLE} />
          ))
        }
      </div>

      <div
        id="infinite-scroll-loader"
        class="mt-12 flex flex-col items-center justify-center py-8 hidden"
      >
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 border-4 border-cizgi border-t-kabuk rounded-tam animate-spin"></div>
          <span class="text-is font-medium">Daha fazla ürün yükleniyor...</span>
        </div>
      </div>

      <div id="end-of-products" class="mt-12 text-center py-8 hidden">
        <p class="text-is font-medium">Tüm ürünler yüklendi</p>
      </div>

      <div id="no-results" class="mt-12 text-center py-8 hidden">
        <p class="text-is font-medium">Aramanıza uygun ürün bulunamadı.</p>
      </div>
</Base>

<style>
  /* Mağaza sayfasına özgü stiller */

  /* Arama alanı — ortaklık formundaki alanla aynı görünüm */
  .form-alan {
    width: 100%;
    padding: 0.55rem 0.8rem;
    background: var(--kum);
    border: 1px solid var(--cizgi);
    border-radius: 6px;
    color: var(--murekkep);
    font-size: 0.9375rem;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  /* Soldaki büyüteç ikonuna yer aç. Tailwind'in pl-10 sınıfı burada işe
     yaramıyor: .form-alan kapsamlı (scoped) olduğu için özgüllüğü daha yüksek. */
  .form-alan--aramali { padding-left: 2.5rem; }
  .form-alan::placeholder { color: var(--is); opacity: 0.75; }
  .form-alan:focus {
    border-color: var(--kabuk);
    background: var(--kagit);
    box-shadow: 0 0 0 3px rgba(107, 69, 38, 0.12);
  }

  /* --- Kategori sekmeleri --- */
  .kategori-serit-sarmal {
    position: sticky;
    /* Header de sticky; şerit onun ALTINA yapışmalı, yoksa arkasında kalıyor.
       Header yüksekliği logo ölçeğiyle birlikte kırılımlarda değişiyor:
       <640px 69, 640–767px 81, >=768px 89. */
    top: 69px;
    z-index: 20;
    margin-bottom: 1.75rem;
    background: var(--kum);
    border-bottom: 1px solid var(--cizgi);
    /* container padding'ini aşıp kenarlara uzansın */
    margin-inline: -1rem;
    padding-inline: 1rem;
  }
  @media (min-width: 640px) { .kategori-serit-sarmal { top: 81px; } }
  @media (min-width: 768px) {
    .kategori-serit-sarmal { top: 89px; margin-inline: -1.5rem; padding-inline: 1.5rem; }
  }

  .kategori-sekmeler {
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .kategori-sekmeler::-webkit-scrollbar { display: none; }

  .kategori-sekme {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    padding: 0.85rem 0.9rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: var(--is);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .kategori-sekme:hover { color: var(--murekkep); }
  .kategori-sekme[aria-selected='true'] {
    color: var(--murekkep);
    border-bottom-color: var(--kabuk);
  }

  .kategori-adet {
    font-size: 0.8125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--is);
    background: var(--kagit);
    border: 1px solid var(--cizgi);
    border-radius: 9999px;
    padding: 0.1rem 0.45rem;
  }
  .kategori-sekme[aria-selected='true'] .kategori-adet {
    color: var(--krem);
    background: var(--kabuk);
    border-color: var(--kabuk);
  }

  /* Filtreye uymayan / henüz açılmamış kartlar */
  :global(.product-hidden) {
    display: none;
  }
</style>

<script>
  import '../scripts/lightbox.js';
  import '../scripts/shop.js';
</script>
