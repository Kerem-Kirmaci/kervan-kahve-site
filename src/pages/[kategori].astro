---
import Base from '../layouts/Base.astro';
import UrunKarti from '../components/UrunKarti.astro';
import Lightbox from '../components/Lightbox.astro';
import KategoriSeridi from '../components/KategoriSeridi.astro';
import Buton from '../components/Buton.astro';
import Ikon from '../components/Ikon.astro';
import { getImage } from 'astro:assets';
import { products } from '../data/products.js';
import { productImage } from '../data/product-images.js';
import { kategoriler, kategoriYolu, urunleriSirala } from '../data/kategoriler.js';

// Kategori sayfaları — /toptan-surup.html, /toptan-kahve.html ...
//
// Bu dosya altı sayfa üretiyor; kategori tanımları, başlıklar ve giriş
// metinleri src/data/kategoriler.js'te. Sayfanın işi, "toptan şurup mersin"
// gibi bir aramada Google'a gösterecek tek konulu bir adres vermek: mağaza
// sayfası 100 ürünü tek adreste tutuyor ve sekmeleri JavaScript'le
// filtrelediği için o aramalarda hiç çıkmıyorduk.
export function getStaticPaths() {
  return kategoriler.map((k) => ({ params: { kategori: k.slug }, props: { kategori: k } }));
}

const { kategori } = Astro.props;
const urunler = urunleriSirala(products.filter((p) => p.category === kategori.key));
const sayfaYolu = kategoriYolu(kategori.key);
const sayfaAdresi = new URL(sayfaYolu, Astro.site).href;

// Yapılandırılmış veri. Liste elemanları bilinçli olarak `Product` değil —
// gerekçe shop.astro'da (fiyatsız Product verisi Search Console'da hata
// sayılıyor). Görsel parametreleri UrunKarti'nın lightbox sürümüyle aynı;
// Astro aynı dosyayı yeniden üretmiyor.
const yapisalGorseller = await Promise.all(
  urunler.map(async (p) => {
    const img = await getImage({ src: productImage(p.image), width: 900, format: 'webp', quality: 78 });
    return new URL(img.src, Astro.site).href;
  })
);

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Kervan Kahve — ${kategori.ad}`,
  url: sayfaAdresi,
  description: kategori.aciklama,
  numberOfItems: urunler.length,
  itemListElement: urunler.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.name,
    image: yapisalGorseller[i],
  })),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Ürünlerimiz', item: new URL('/shop.html', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: kategori.ad, item: sayfaAdresi },
  ],
};
---

<Base
  title={kategori.sayfaBasligi}
  description={kategori.aciklama}
  activePage="shop"
  mainClass="container mx-auto px-6 py-12"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumb)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(itemList)} />

  <Lightbox />

  <nav aria-label="Konum" class="mb-4 text-kucuk text-is">
    <ol class="flex flex-wrap items-center gap-x-2">
      <li><a href="/index.html" class="hover:text-murekkep">Ana Sayfa</a></li>
      <li aria-hidden="true"><Ikon ad="chevron-sag" boyut={14} /></li>
      <li><a href="/shop.html" class="hover:text-murekkep">Ürünlerimiz</a></li>
      <li aria-hidden="true"><Ikon ad="chevron-sag" boyut={14} /></li>
      <li aria-current="page" class="text-murekkep font-semibold">{kategori.ad}</li>
    </ol>
  </nav>

  <div class="mb-8 flex items-start gap-4">
    <span class="hidden sm:flex shrink-0 w-12 h-12 rounded items-center justify-center bg-kagit border border-cizgi text-kabuk">
      <Ikon ad={kategori.ikon} boyut={26} />
    </span>
    <div class="min-w-0">
      <h1 class="text-buyuk font-bold text-murekkep">{kategori.baslik}</h1>
      <p class="mt-2 text-govde text-is">
        {urunler.length} ürün — Mersin ve çevresindeki kafe, restoran ve otellere, kendi aracımızla.
      </p>
      <div class="mt-5 space-y-3">
        {kategori.giris.map((paragraf: string) => (
          <p class="text-govde text-murekkep max-w-okuma">{paragraf}</p>
        ))}
      </div>
    </div>
  </div>

  <KategoriSeridi aktif={kategori.key} />

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 sm:gap-4 md:gap-5">
    {urunler.map((product, i) => <UrunKarti product={product} eager={i < 6} />)}
  </div>

  {/* Sayfanın tek eylemi. Fiyat listede yok — toptan fiyat menüye ve hacme
      göre çıkıyor; o yüzden kartlarda "sepete ekle" değil burada "teklif".
      Telefon bağlantısı altın değil: aynı yüzeyde altın buton var, ikisi bir
      arada kullanılmaz (Renk kuralı 1). */}
  <section class="mt-12 md:mt-16 rounded border border-cizgi bg-kagit p-6 md:p-8">
    <h2 class="text-orta text-murekkep">Bu ürünler için fiyat alın</h2>
    <p class="mt-3 text-govde text-is max-w-okuma">
      Liste fiyatı yok; menünüze ve tahmini tüketiminize göre fiyat çıkarıyoruz.
      Formu doldurun ya da doğrudan arayın:{' '}
      <a href="tel:+905453207713" class="font-semibold text-murekkep underline underline-offset-4 decoration-cizgi hover:decoration-kabuk whitespace-nowrap">+90 545 320 77 13</a>
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <Buton href="/ortaklik.html" variant="vurgu" boyut="buyuk">Teklif alın</Buton>
      <Buton href="/shop.html" variant="ikincil" boyut="buyuk" ikon="ok-sag" ikonSonda>Tüm ürünler</Buton>
    </div>
  </section>
</Base>

<script>
  import '../scripts/lightbox.js';
</script>
