---
import Base from '../layouts/Base.astro';
import Ikon from '../components/Ikon.astro';
import Buton from '../components/Buton.astro';

// Sayfanın tek işi: başvuru formunun doldurulması. Bu yüzden form artık
// kaydırmadan görünüyor — eskiden üçüncü bölümdeydi, önünde iki ekran
// dolusu tanıtım vardı.

const kazanimlar = [
  { ikon: 'kahve', baslik: 'Tek tedarikçi',
    metin: 'Kahve, şurup, püre, tatlı, çay ve ekipman aynı faturada. Altı ayrı firmayla uğraşmıyorsunuz.' },
  { ikon: 'is', baslik: 'Barista eğitimi',
    metin: 'Personelinize ürün kullanımı ve temel kahve hazırlama eğitimi veriyoruz.' },
  { ikon: 'ekipman', baslik: 'Ekipman ve servis',
    metin: 'Makine seçiminde danışmanlık, kurulum ve düzenli bakım desteği.' },
  { ikon: 'surup', baslik: 'Size özel harman',
    metin: 'Menünüze ve müşteri profilinize göre kavrum ve harman ayarı yapıyoruz.' },
];

const sorular = [
  { s: 'Minimum sipariş miktarı nedir?',
    c: 'Ürüne göre değişiyor. Menünüzü ve tahmini tüketiminizi konuştuktan sonra net rakam veriyoruz.' },
  { s: 'Sipariş ne kadar sürede geliyor?',
    c: 'Siparişler genellikle 2-3 iş günü içinde işlenip kargoya veriliyor. Mersin içinde aynı gün teslimat yapabiliyoruz.' },
  { s: 'Personelimize eğitim veriyor musunuz?',
    c: 'Evet. Ürün kullanımı ve temel kahve hazırlama eğitimini işletmenizde, kendi ekipmanınız üzerinde veriyoruz.' },
  { s: 'Hangi ürünleri tedarik ediyorsunuz?',
    c: 'Kahve çekirdeği, şurup, püre ve tatlandırıcı, hazır tatlı, bitki çayı ve kahve ekipmanı. Katalogda bugün 100 ürün var.' },
  { s: 'Özel kahve harmanı talep edebilir miyim?',
    c: 'Evet. İşletmenizin karakterine uygun karışımı birlikte belirliyor, örnek kavurmayla test ediyoruz.' },
];

const alanlar = [
  { id: 'company-name', etiket: 'Şirket adı', tur: 'text', ipucu: 'İşletmenizin adı', genis: false, autocomplete: 'organization' },
  { id: 'contact-person', etiket: 'Yetkili kişi', tur: 'text', ipucu: 'Ad ve soyad', genis: false, autocomplete: 'name' },
  { id: 'email', etiket: 'E-posta', tur: 'email', ipucu: 'ornek@sirket.com', genis: false, autocomplete: 'email' },
  { id: 'phone', etiket: 'Telefon', tur: 'tel', ipucu: '5xx xxx xx xx', genis: false, autocomplete: 'tel' },
  { id: 'business-type', etiket: 'İşletme türü', tur: 'text', ipucu: 'Kafe, restoran, otel…', genis: true, autocomplete: 'off' },
];
---

<Base
  title="İş Ortaklığı — Kervan Kahve"
  description="Kafe ve restoranlara toptan tedarik. Tek faturada kahve, şurup, tatlı ve ekipman; barista eğitimi ve makine servisi. Başvuru formu."
  activePage="ortaklik"
>
  <!-- ==================================================================
       Teklif isteme — sayfanın işi bu, kaydırmadan görünüyor
       =================================================================== -->
  <section class="koyu-zemin bg-kavurma text-krem">
    <div class="container mx-auto px-4 md:px-6 py-12 md:py-16">
      <div class="grid lg:grid-cols-[1fr_1.1fr] gap-10 lg:gap-14 items-start">
        <div>
          <h1 class="text-buyuk text-krem">İşletmenizin tedarikçisi olalım</h1>
          <p class="mt-5 text-govde text-krem-ikincil max-w-okuma">
            Mersin ve çevresinde 100'den fazla kafe, restoran ve otelle çalışıyoruz.
            Formu doldurun, menünüze ve hacminize göre fiyat çıkaralım.
          </p>

          <ul class="mt-8 space-y-4">
            {kazanimlar.map((k) => (
              <li class="flex gap-4">
                <span class="shrink-0 mt-0.5 text-altin"><Ikon ad={k.ikon} boyut={22} /></span>
                <div>
                  <h2 class="text-govde font-semibold text-krem">{k.baslik}</h2>
                  <p class="mt-1 text-kucuk text-krem-ikincil max-w-okuma">{k.metin}</p>
                </div>
              </li>
            ))}
          </ul>

          <p class="mt-8 text-kucuk text-krem-ikincil">
            Formu doldurmak istemiyorsanız doğrudan arayın:
            <a href="tel:+905453207713" class="text-altin font-semibold hover:underline">+90 545 320 77 13</a>
          </p>
        </div>

        <!-- Başvuru formu -->
        <div id="application-form" class="bg-kagit text-murekkep rounded p-5 md:p-8 scroll-mt-28">
          <h2 class="text-alt text-murekkep">Teklif isteyin</h2>
          <p class="mt-2 text-kucuk text-is">
            Gönderdiğinizde WhatsApp açılır, bilgileriniz mesaja hazır gelir.
          </p>

          <form id="partnership-form" class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
            {alanlar.map((a) => (
              <div class={a.genis ? 'md:col-span-2' : ''}>
                <label for={a.id} class="block text-kucuk font-semibold text-murekkep mb-1">{a.etiket}</label>
                <input
                  id={a.id}
                  type={a.tur}
                  placeholder={a.ipucu}
                  autocomplete={a.autocomplete}
                  required
                  class="form-alan"
                />
              </div>
            ))}

            <div class="md:col-span-2">
              <label for="message" class="block text-kucuk font-semibold text-murekkep mb-1">İşletmeniz hakkında</label>
              <textarea
                id="message"
                rows="4"
                placeholder="Konumunuz, günlük kaç fincan servis ediyorsunuz, hangi ürünlere ihtiyacınız var?"
                required
                class="form-alan"></textarea>
            </div>

            <div class="md:col-span-2">
              <label for="kvkk-consent" class="flex items-start gap-3 text-mini text-is cursor-pointer">
                <input
                  id="kvkk-consent"
                  type="checkbox"
                  required
                  class="mt-0.5 h-4 w-4 shrink-0 rounded border-cizgi text-kabuk focus:ring-kabuk"
                />
                <span>
                  Formda paylaştığım ad, e-posta ve telefon bilgilerimin talebimin
                  değerlendirilmesi amacıyla işlenmesini kabul ediyorum.{' '}
                  <a href="/gizlilik-politikasi.html" class="underline hover:text-kabuk">Gizlilik Politikası</a>{"'"}nı
                  inceleyebilirsiniz.
                </span>
              </label>
            </div>

            <div class="md:col-span-2">
              <button type="submit" class="gonder-butonu">
                <Ikon ad="whatsapp" boyut={18} />
                WhatsApp ile gönder
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================================================================
       Sıkça sorulanlar — formu doldurmadan önceki tereddütler
       =================================================================== -->
  <section class="bg-kum py-14 md:py-20">
    <div class="container mx-auto px-4 md:px-6">
      <h2 class="text-orta text-murekkep">Sıkça sorulanlar</h2>
      <div class="mt-8 max-w-3xl border-t border-cizgi">
        {sorular.map((q) => (
          <details class="sss border-b border-cizgi">
            <summary>
              <span>{q.s}</span>
              <span class="sss-isaret" aria-hidden="true"><Ikon ad="chevron-sag" boyut={18} /></span>
            </summary>
            <p class="pb-5 text-is max-w-okuma">{q.c}</p>
          </details>
        ))}
      </div>

      <div class="mt-10">
        <Buton href="#application-form" variant="vurgu" boyut="buyuk">Teklif isteyin</Buton>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/partnership-form.js';
</script>

<style>
  .form-alan {
    width: 100%;
    padding: 0.6rem 0.85rem;
    background: var(--kum);
    border: 1px solid var(--cizgi);
    border-radius: 6px;
    color: var(--murekkep);
    font-size: 0.9375rem;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .form-alan::placeholder { color: var(--is); opacity: 0.75; }
  .form-alan:focus {
    border-color: var(--kabuk);
    background: var(--kagit);
    box-shadow: 0 0 0 3px rgba(107, 69, 38, 0.12);
  }

  .gonder-butonu {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 3rem;
    padding: 0 1.5rem;
    background: var(--kabuk);
    color: var(--krem);
    font-weight: 600;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .gonder-butonu:hover { background: var(--kavurma); }

  /* Sıkça sorulanlar — açılır kapanır, tarayıcının kendi davranışıyla */
  .sss > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 0;
    font-weight: 600;
    color: var(--murekkep);
    cursor: pointer;
    list-style: none;
  }
  .sss > summary::-webkit-details-marker { display: none; }
  .sss > summary:hover { color: var(--kabuk); }
  .sss-isaret {
    flex-shrink: 0;
    color: var(--kabuk);
    transition: transform 0.2s ease;
  }
  .sss[open] .sss-isaret { transform: rotate(90deg); }
  .sss > p { margin-top: 0; }
</style>
