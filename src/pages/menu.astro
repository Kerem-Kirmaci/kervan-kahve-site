---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
---

<Base
  title="Menümüz Yenileniyor - Kervan Kahve"
  description="Kervan Kahve dijital menüsü yenileniyor. Bu sırada bize WhatsApp veya telefonla ulaşabilirsiniz."
  noindex
>
  <section class="container mx-auto px-6 py-16 md:py-24">
    <div class="max-w-lg mx-auto text-center bg-white rounded-xl shadow-lg p-8 md:p-12">
      <Image
        src={logo}
        alt="Kervan Kahve"
        width={160}
        height={160}
        class="h-24 w-auto mx-auto object-contain"
      />

      <h1 class="mt-6 text-2xl md:text-3xl font-bold text-gray-900">Menümüz Yenileniyor</h1>

      <p class="mt-4 text-gray-600">
        Dijital menümüz üzerinde çalışıyoruz. Kısa süre içinde burada olacak.
        O zamana kadar sipariş ve bilgi için bize doğrudan ulaşabilirsiniz.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="https://wa.me/905453207713"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg brand-bg text-white font-semibold hover:bg-opacity-90 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M187.58,144.84l-32-16a8,8,0,0,0-8,.5l-14.69,9.8a40.55,40.55,0,0,1-16-16l9.8-14.69a8,8,0,0,0,.5-8l-16-32A8,8,0,0,0,104,64a40,40,0,0,0-40,40,88.1,88.1,0,0,0,88,88,40,40,0,0,0,40-40A8,8,0,0,0,187.58,144.84ZM152,176a72.08,72.08,0,0,1-72-72A24,24,0,0,1,99.29,80.46l11.48,23L101,118a8,8,0,0,0-.73,7.51,56.47,56.47,0,0,0,30.15,30.15A8,8,0,0,0,138,155l14.61-9.74,23,11.48A24,24,0,0,1,152,176ZM128,24A104,104,0,0,0,36.18,176.88L24.83,210.93a16,16,0,0,0,20.24,20.24l34.05-11.35A104,104,0,1,0,128,24Zm0,192a87.87,87.87,0,0,1-44.06-11.81,8,8,0,0,0-6.54-.67L40,216,52.47,178.6a8,8,0,0,0-.66-6.54A88,88,0,1,1,128,216Z"></path></svg>
          WhatsApp ile Yaz
        </a>
        <a
          href="tel:+905453207713"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg border border-gray-300 text-gray-700 font-semibold hover:bg-gray-50 transition-colors"
        >
          <span class="material-icons text-lg" aria-hidden="true">call</span>
          +90 545 320 77 13
        </a>
      </div>

      <p class="mt-8 text-sm text-gray-500">
        Ürünlerimizin tamamını <a href="/shop.html" class="brand-text underline">ürünler sayfamızdan</a> inceleyebilirsiniz.
      </p>
    </div>
  </section>
</Base>
