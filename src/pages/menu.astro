---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import Ikon from '../components/Ikon.astro';
---

<Base
  title="Menümüz Yenileniyor - Kervan Kahve"
  description="Kervan Kahve dijital menüsü yenileniyor. Bu sırada bize WhatsApp veya telefonla ulaşabilirsiniz."
  noindex
>
  <section class="container mx-auto px-6 py-16 md:py-24">
    <div class="max-w-lg mx-auto text-center bg-kagit rounded shadow-kart p-8 md:p-12">
      <Image
        src={logo}
        alt="Kervan Kahve"
        width={160}
        height={160}
        class="h-24 w-auto mx-auto object-contain"
      />

      <h1 class="mt-6 text-buyuk font-bold text-murekkep">Menümüz Yenileniyor</h1>

      <p class="mt-4 text-is">
        Dijital menümüz üzerinde çalışıyoruz. Kısa süre içinde burada olacak.
        O zamana kadar sipariş ve bilgi için bize doğrudan ulaşabilirsiniz.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="https://wa.me/905453207713"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded bg-kabuk text-krem font-semibold hover:bg-opacity-90 transition-colors"
        >
          <Ikon ad="whatsapp" boyut={20} />
          WhatsApp ile Yaz
        </a>
        <a
          href="tel:+905453207713"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded border border-cizgi text-murekkep font-semibold hover:bg-kum transition-colors"
        >
          <Ikon ad="telefon" />
          +90 545 320 77 13
        </a>
      </div>

      <p class="mt-8 text-kucuk text-is">
        Ürünlerimizin tamamını <a href="/shop.html" class="text-altin-koyu underline">ürünler sayfamızdan</a> inceleyebilirsiniz.
      </p>
    </div>
  </section>
</Base>
