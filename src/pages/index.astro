  /* Logolar 512x160 tuvale ortalı geliyor ve her birinin tuval içindeki yatay
     şeffaf payı farklı (hario 93px, doro 182px). Kutular eşit genişlikte
     olduğu için doro komşularından ~2 kat uzak duruyordu. Her kutuyu kendi
     payı kadar içeri çekip aradaki görünür boşluğu eşitliyoruz:
     pay(px) = --pad, kutuda karşılığı = --pad / 512 * --box,
     hedef boşluk = 0.1875 * --box (lg'de 48px). */
  .partner-marquee .pm-cell {
      margin-inline: calc(var(--box) * (0.09375 - var(--pad) / 512));
