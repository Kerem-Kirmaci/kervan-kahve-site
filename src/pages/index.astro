---
import Base from '../layouts/Base.astro';
import SliderCard from '../components/SliderCard.astro';
import Lightbox from '../components/Lightbox.astro';
import { Image } from 'astro:assets';
import { assetImage } from '../data/product-images.js';
import { homeSliders } from '../data/home-sliders.js';

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Kervan Kuru Kahvecisi',
  url: 'https://kervankahve.com',
  logo: 'https://kervankahve.com/og-image.jpg',
  image: 'https://kervankahve.com/og-image.jpg',
  description:
    'Nitelikli kahve çekirdeklerini ustalıkla kavuruyor, işletmelere ve kahve severlere ulaştırıyoruz. İş ortaklığı, barista eğitimi ve özel karışımlar.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Cami Şerif, İstiklal Cd. 26-1',
    addressLocality: 'Akdeniz',
    addressRegion: 'Mersin',
    postalCode: '33060',
    addressCountry: 'TR',
  },
  telephone: '+905453207713',
  email: 'info@kervankahve.com',
  foundingDate: '2015',
  sameAs: ['https://www.instagram.com/kervankahve_toptan__perakende/'],
};
---

<Base
  title="Kervan Kahve - Nitelikli Kahve Çözümleri"
  description="Kervan Kahve - Nitelikli kahve çekirdeklerini ustalıkla kavuruyor, işletmelere ve kahve severlere ulaştırıyoruz. İş ortaklığı, barista eğitimi ve özel karışımlar."
  activePage="index"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(localBusiness)} />

  <Lightbox />

  <!-- Kategori Marquee (Header'ın hemen altında) - Sadece desktop/tablet -->
  <section class="hidden md:block bg-white border-b border-amber-100/60 overflow-x-hidden">
    <div class="category-marquee">
      <div class="marquee-track">
        <!-- Tek set (tüm kategoriler) -->
        <div class="category-row flex gap-0">
          <a href="#kategori-surup" class="category-card overflow-hidden">
            <Image src={assetImage('images/category-cards/syrup-banner.webp')} alt="Şuruplar" width={400} />
            <div class="overlay"></div>
            <div class="label">
              <div class="text-white text-xl font-extrabold tracking-tight">🍯 Şuruplar</div>
              <div class="text-white/80 text-xs">Tatlandıran aromalar</div>
            </div>
          </a>
          <a href="#kategori-pure-tatlandirici" class="category-card overflow-hidden">
            <Image src={assetImage('images/category-cards/pure-tatlandirici-banner.webp')} alt="Püre ve Tatlandırıcılar" width={400} />
            <div class="overlay"></div>
            <div class="label">
              <div class="text-white text-xl font-extrabold tracking-tight">🥤 Püre & Tatlandırıcılar</div>
              <div class="text-white/80 text-xs">Özel formüller ve soslar</div>
            </div>
          </a>
          <a href="#kategori-tatli" class="category-card overflow-hidden">
            <Image src={assetImage('images/category-cards/sweet-banner.webp')} alt="Tatlılar" width={400} />
            <div class="overlay"></div>
            <div class="label">
              <div class="text-white text-xl font-extrabold tracking-tight">🍰 Tatlılar</div>
              <div class="text-white/80 text-xs">Günlük taze lezzetler</div>
            </div>
          </a>
          <a href="#kategori-kahve" class="category-card overflow-hidden">
            <Image src={assetImage('images/category-cards/espresso-banner.webp')} alt="Kahveler" width={400} />
            <div class="overlay"></div>
            <div class="label">
              <div class="text-white text-xl font-extrabold tracking-tight">☕ Kahveler</div>
              <div class="text-white/80 text-xs">Tüm kahve çeşitleri</div>
            </div>
          </a>
          <a href="#kategori-cay" class="category-card overflow-hidden">
            <Image src={assetImage('images/category-cards/cay-banner.webp')} alt="Bitki Çayları" width={400} />
            <div class="overlay"></div>
            <div class="label">
              <div class="text-white text-xl font-extrabold tracking-tight">🍵 Bitki Çayları</div>
              <div class="text-white/80 text-xs">Doğal ve aromalı</div>
            </div>
          </a>
          <a href="#kategori-aksesuar" class="category-card overflow-hidden">
            <Image src={assetImage('images/category-cards/aksesuar-banner.webp')} alt="Aksesuarlar" width={400} />
            <div class="overlay"></div>
            <div class="label">
              <div class="text-white text-xl font-extrabold tracking-tight">⚙️ Aksesuarlar</div>
              <div class="text-white/80 text-xs">Demleme ekipmanları</div>
            </div>
          </a>
        </div>
        <!-- Tekrar set (sonsuzluk etkisi için aynı içerik) -->
        <div class="category-row flex gap-0" aria-hidden="true">
          <a href="#kategori-surup" class="category-card overflow-hidden">
            <Image src={assetImage('images/category-cards/syrup-banner.webp')} alt="Şuruplar" width={400} />
            <div class="overlay"></div>
            <div class="label">
              <div class="text-white text-xl font-extrabold tracking-tight">🍯 Şuruplar</div>
              <div class="text-white/80 text-xs">Tatlandıran aromalar</div>
            </div>
          </a>
          <a href="#kategori-pure-tatlandirici" class="category-card overflow-hidden">
            <Image src={assetImage('images/category-cards/pure-tatlandirici-banner.webp')} alt="Püre ve Tatlandırıcılar" width={400} />
            <div class="overlay"></div>
            <div class="label">
              <div class="text-white text-xl font-extrabold tracking-tight">🥤 Püre & Tatlandırıcılar</div>
              <div class="text-white/80 text-xs">Özel formüller ve soslar</div>
            </div>
          </a>
          <a href="#kategori-tatli" class="category-card overflow-hidden">
            <Image src={assetImage('images/category-cards/sweet-banner.webp')} alt="Tatlılar" width={400} />
            <div class="overlay"></div>
            <div class="label">
              <div class="text-white text-xl font-extrabold tracking-tight">🍰 Tatlılar</div>
              <div class="text-white/80 text-xs">Günlük taze lezzetler</div>
            </div>
          </a>
          <a href="#kategori-kahve" class="category-card overflow-hidden">
            <Image src={assetImage('images/category-cards/espresso-banner.webp')} alt="Kahveler" width={400} />
            <div class="overlay"></div>
            <div class="label">
              <div class="text-white text-xl font-extrabold tracking-tight">☕ Kahveler</div>
              <div class="text-white/80 text-xs">Tüm kahve çeşitleri</div>
            </div>
          </a>
          <a href="#kategori-cay" class="category-card overflow-hidden">
            <Image src={assetImage('images/category-cards/cay-banner.webp')} alt="Bitki Çayları" width={400} />
            <div class="overlay"></div>
            <div class="label">
              <div class="text-white text-xl font-extrabold tracking-tight">🍵 Bitki Çayları</div>
              <div class="text-white/80 text-xs">Doğal ve aromalı</div>
            </div>
          </a>
          <a href="#kategori-aksesuar" class="category-card overflow-hidden">
            <Image src={assetImage('images/category-cards/aksesuar-banner.webp')} alt="Aksesuarlar" width={400} />
            <div class="overlay"></div>
            <div class="label">
              <div class="text-white text-xl font-extrabold tracking-tight">⚙️ Aksesuarlar</div>
              <div class="text-white/80 text-xs">Demleme ekipmanları</div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>
  <!-- Hero Section - Mobil Optimize -->
  <section class="container mx-auto px-4 md:px-6 py-4 md:py-12">
    <!-- Mobil Görünüm -->
    <div class="md:hidden space-y-6">
      <!-- Büyük Başlık -->
      <h1 class="text-3xl font-extrabold text-gray-900 leading-tight">
        Kahveden Bitki Çayına, Tatlıdan Şuruba: <span class="brand-text">Tüm Lezzetler</span> Bir Arada
      </h1>

      <!-- Kategoriler -->
      <div>
        <h2 class="text-xl font-semibold mb-4 text-gray-900">Kategoriler</h2>
        <div class="flex overflow-x-auto space-x-4 pb-4 no-scrollbar">
          <a href="#kategori-surup-mobile" class="flex-shrink-0 w-28 text-center">
            <Image src={assetImage('images/category-cards/syrup-banner.webp')} alt="Syrups" class="w-28 h-36 object-cover rounded-lg shadow-md" width={400} />
            <p class="mt-2 text-sm font-medium text-gray-900">Şuruplar</p>
          </a>
          <a href="#kategori-pure-tatlandirici-mobile" class="flex-shrink-0 w-28 text-center">
            <Image src={assetImage('images/category-cards/pure-tatlandirici-banner.webp')} alt="Püre ve Tatlandırıcılar" class="w-28 h-36 object-cover rounded-lg shadow-md" width={400} />
            <p class="mt-2 text-sm font-medium text-gray-900">Püre & Tatl.</p>
          </a>
          <a href="#kategori-tatli-mobile" class="flex-shrink-0 w-28 text-center">
            <Image src={assetImage('images/category-cards/sweet-banner.webp')} alt="Desserts" class="w-28 h-36 object-cover rounded-lg shadow-md" width={400} />
            <p class="mt-2 text-sm font-medium text-gray-900">Tatlılar</p>
          </a>
          <a href="#kategori-kahve-mobile" class="flex-shrink-0 w-28 text-center">
            <Image src={assetImage('images/category-cards/espresso-banner.webp')} alt="Coffee" class="w-28 h-36 object-cover rounded-lg shadow-md" width={400} />
            <p class="mt-2 text-sm font-medium text-gray-900">Kahveler</p>
          </a>
          <a href="#kategori-cay-mobile" class="flex-shrink-0 w-28 text-center">
            <Image src={assetImage('images/category-cards/cay-banner.webp')} alt="Teas" class="w-28 h-36 object-cover rounded-lg shadow-md" width={400} />
            <p class="mt-2 text-sm font-medium text-gray-900">Bitki Çayları</p>
          </a>
          <a href="#kategori-aksesuar-mobile" class="flex-shrink-0 w-28 text-center">
            <Image src={assetImage('images/category-cards/aksesuar-banner.webp')} alt="Accessories" class="w-28 h-36 object-cover rounded-lg shadow-md" width={400} />
            <p class="mt-2 text-sm font-medium text-gray-900">Ekipmanlar</p>
          </a>
        </div>
      </div>

      <!-- İş Ortakları -->
      <div>
        <h2 class="text-xl font-semibold mb-4 text-gray-900">İş Ortaklarımız</h2>
        {/* Logolar 512x160 tuvale önceden ölçeklenip ortalanmış hâlde geliyor
            (bkz. src/assets/images/partnerships). Bu yüzden logo başına elle
            yükseklik vermeye gerek yok; hepsi aynı kutuya oturuyor. */}
        <div class="partner-marquee partner-marquee--mobile overflow-hidden pb-4">
          <div class="marquee-track">
            <div class="flex items-center">
              <div class="pm-cell h-12 w-[9.6rem] flex items-center justify-center flex-shrink-0" style="--pad:182">
                <Image src={assetImage('images/partnerships/doro.png')} alt="D'oro Cake logo" class="max-h-full max-w-full object-contain" width={512} />
              </div>
              <div class="pm-cell h-12 w-[9.6rem] flex items-center justify-center flex-shrink-0" style="--pad:93">
                <Image src={assetImage('images/partnerships/hario.png')} alt="Hario logo" class="max-h-full max-w-full object-contain" width={512} />
              </div>
              <div class="pm-cell h-12 w-[9.6rem] flex items-center justify-center flex-shrink-0" style="--pad:98">
                <Image src={assetImage('images/partnerships/cimbali.png')} alt="La Cimbali logo" class="max-h-full max-w-full object-contain" width={512} />
              </div>
              <div class="pm-cell h-12 w-[9.6rem] flex items-center justify-center flex-shrink-0" style="--pad:137">
                <Image src={assetImage('images/partnerships/davinci.png')} alt="DaVinci logo" class="max-h-full max-w-full object-contain" width={512} />
              </div>
              <div class="pm-cell h-12 w-[9.6rem] flex items-center justify-center flex-shrink-0" style="--pad:99">
                <Image src={assetImage('images/partnerships/gusse.png')} alt="Gusse logo" class="max-h-full max-w-full object-contain" width={512} />
              </div>
              <div class="pm-cell h-12 w-[9.6rem] flex items-center justify-center flex-shrink-0" style="--pad:155">
                <Image src={assetImage('images/partnerships/fo.png')} alt="Fo Food Products logo" class="max-h-full max-w-full object-contain" width={512} />
              </div>
            </div>
              <!-- Sonsuzluk etkisi için tekrar -->
            <div class="flex items-center" aria-hidden="true">
              <div class="pm-cell h-12 w-[9.6rem] flex items-center justify-center flex-shrink-0" style="--pad:182">
                <Image src={assetImage('images/partnerships/doro.png')} alt="D'oro Cake logo" class="max-h-full max-w-full object-contain" width={512} />
              </div>
              <div class="pm-cell h-12 w-[9.6rem] flex items-center justify-center flex-shrink-0" style="--pad:93">
                <Image src={assetImage('images/partnerships/hario.png')} alt="Hario logo" class="max-h-full max-w-full object-contain" width={512} />
              </div>
              <div class="pm-cell h-12 w-[9.6rem] flex items-center justify-center flex-shrink-0" style="--pad:98">
                <Image src={assetImage('images/partnerships/cimbali.png')} alt="La Cimbali logo" class="max-h-full max-w-full object-contain" width={512} />
              </div>
              <div class="pm-cell h-12 w-[9.6rem] flex items-center justify-center flex-shrink-0" style="--pad:137">
                <Image src={assetImage('images/partnerships/davinci.png')} alt="DaVinci logo" class="max-h-full max-w-full object-contain" width={512} />
              </div>
              <div class="pm-cell h-12 w-[9.6rem] flex items-center justify-center flex-shrink-0" style="--pad:99">
                <Image src={assetImage('images/partnerships/gusse.png')} alt="Gusse logo" class="max-h-full max-w-full object-contain" width={512} />
              </div>
              <div class="pm-cell h-12 w-[9.6rem] flex items-center justify-center flex-shrink-0" style="--pad:155">
                <Image src={assetImage('images/partnerships/fo.png')} alt="Fo Food Products logo" class="max-h-full max-w-full object-contain" width={512} />
              </div>
            </div>
            </div>
        </div>
      </div>

      <!-- CTA Butonları -->
      <div class="flex gap-4">
        <a href="/shop.html" class="flex-1 py-3 brand-bg text-white rounded-lg font-semibold text-center shadow-md hover:shadow-lg transition-all">
          Ürünleri Keşfet
        </a>
        <a href="/ortaklik.html" class="flex-1 py-3 bg-gray-200 text-gray-800 rounded-lg font-semibold text-center shadow-md hover:shadow-lg transition-all">
          İş Ortağı Ol
        </a>
      </div>
    </div>

    <!-- Desktop/Tablet Görünüm -->
    <div class="hidden md:grid lg:grid-cols-2 gap-6 lg:gap-12 items-center">
      {/* min-w-0: grid öğesinin varsayılan min-width:auto değeri, içindeki
          marquee şeridinin max-content genişliğine (1440px) kilitleniyordu ve
          tablet boyutunda içerik ekranın dışına taşıyordu. */}
      <div class="fade-in min-w-0">
        <h2 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl xl:text-5xl font-extrabold text-gray-900 leading-tight">Kahveden Bitki Çayına, Tatlıdan Şuruba: <span class="brand-text">Tüm Lezzetler</span> Bir Arada</h2>
        <!-- Ortaklık logoları marquee - sadece tablet ve üstünde göster -->
        <div class="mt-4 md:mt-6 partner-marquee overflow-hidden">
          <div class="marquee-track">
            <div class="flex items-center gap-2 md:gap-0">
              <div class="pm-cell h-14 md:h-20 w-32 sm:w-40 md:w-60 lg:w-64 flex items-center justify-center flex-shrink-0" style="--pad:93">
                <Image src={assetImage('images/partnerships/hario.png')} alt="Hario" class="max-h-full max-w-full object-contain" width={512} />
              </div>
              <div class="pm-cell h-14 md:h-20 w-32 sm:w-40 md:w-60 lg:w-64 flex items-center justify-center flex-shrink-0" style="--pad:98">
                <Image src={assetImage('images/partnerships/cimbali.png')} alt="La Cimbali" class="max-h-full max-w-full object-contain" width={512} />
              </div>
              <div class="pm-cell h-14 md:h-20 w-32 sm:w-40 md:w-60 lg:w-64 flex items-center justify-center flex-shrink-0" style="--pad:137">
                <Image src={assetImage('images/partnerships/davinci.png')} alt="DaVinci Gourmet" class="max-h-full max-w-full object-contain" width={512} />
              </div>
              <div class="pm-cell h-14 md:h-20 w-32 sm:w-40 md:w-60 lg:w-64 flex items-center justify-center flex-shrink-0" style="--pad:99">
                <Image src={assetImage('images/partnerships/gusse.png')} alt="Gusse" class="max-h-full max-w-full object-contain" width={512} />
              </div>
              <div class="pm-cell h-14 md:h-20 w-32 sm:w-40 md:w-60 lg:w-64 flex items-center justify-center flex-shrink-0" style="--pad:155">
                <Image src={assetImage('images/partnerships/fo.png')} alt="Fo Food Products" class="max-h-full max-w-full object-contain" width={512} />
              </div>
              <div class="pm-cell h-14 md:h-20 w-32 sm:w-40 md:w-60 lg:w-64 flex items-center justify-center flex-shrink-0" style="--pad:182">
                <Image src={assetImage('images/partnerships/doro.png')} alt="D'ORO Cake" class="max-h-full max-w-full object-contain" width={512} />
              </div>
            </div>
            <!-- Sonsuzluk etkisi için tekrar -->
            <div class="flex items-center gap-2 md:gap-0" aria-hidden="true">
              <div class="pm-cell h-14 md:h-20 w-32 sm:w-40 md:w-60 lg:w-64 flex items-center justify-center flex-shrink-0" style="--pad:93">
                <Image src={assetImage('images/partnerships/hario.png')} alt="Hario" class="max-h-full max-w-full object-contain" width={512} />
              </div>
              <div class="pm-cell h-14 md:h-20 w-32 sm:w-40 md:w-60 lg:w-64 flex items-center justify-center flex-shrink-0" style="--pad:98">
                <Image src={assetImage('images/partnerships/cimbali.png')} alt="La Cimbali" class="max-h-full max-w-full object-contain" width={512} />
              </div>
              <div class="pm-cell h-14 md:h-20 w-32 sm:w-40 md:w-60 lg:w-64 flex items-center justify-center flex-shrink-0" style="--pad:137">
                <Image src={assetImage('images/partnerships/davinci.png')} alt="DaVinci Gourmet" class="max-h-full max-w-full object-contain" width={512} />
              </div>
              <div class="pm-cell h-14 md:h-20 w-32 sm:w-40 md:w-60 lg:w-64 flex items-center justify-center flex-shrink-0" style="--pad:99">
                <Image src={assetImage('images/partnerships/gusse.png')} alt="Gusse" class="max-h-full max-w-full object-contain" width={512} />
              </div>
              <div class="pm-cell h-14 md:h-20 w-32 sm:w-40 md:w-60 lg:w-64 flex items-center justify-center flex-shrink-0" style="--pad:155">
                <Image src={assetImage('images/partnerships/fo.png')} alt="Fo Food Products" class="max-h-full max-w-full object-contain" width={512} />
              </div>
              <div class="pm-cell h-14 md:h-20 w-32 sm:w-40 md:w-60 lg:w-64 flex items-center justify-center flex-shrink-0" style="--pad:182">
                <Image src={assetImage('images/partnerships/doro.png')} alt="D'ORO Cake" class="max-h-full max-w-full object-contain" width={512} />
              </div>
            </div>
          </div>
        </div>
        <div class="mt-5 md:mt-8 flex flex-row gap-2 sm:gap-3 md:gap-4">
          <a href="/shop.html" class="brand-bg text-white px-3 sm:px-5 md:px-6 py-2 sm:py-2.5 md:py-3 rounded-lg font-semibold text-xs sm:text-sm md:text-base lg:text-lg hover:bg-opacity-90 transition-transform hover:scale-105 text-center flex-1">Ürünleri Keşfet</a>
          <a href="/ortaklik.html" class="bg-gray-200 text-gray-800 px-3 sm:px-5 md:px-6 py-2 sm:py-2.5 md:py-3 rounded-lg font-semibold text-xs sm:text-sm md:text-base lg:text-lg hover:bg-gray-300 transition-transform hover:scale-105 text-center flex-1">İş Ortağı Ol</a>
        </div>
      </div>
      <div class="fade-in fade-in-delay-1 hidden lg:block">
        <div class="rounded-2xl overflow-hidden shadow-2xl hover:shadow-3xl hover:scale-105 transition-all duration-500">
          <Image src={assetImage('images/anasayfa.jpeg')} alt="Kervan Kahve - Artisanal Coffee" class="w-full h-auto object-cover" width={1200} />
        </div>
      </div>
    </div>
  </section>

  <!-- Çok Satan Ürünlerimiz Section -->
  <section class="bestseller-section py-16 md:py-24">
    <div class="container mx-auto px-4 md:px-6">
      <!-- Section Header -->
      <div class="text-center mb-12 md:mb-16 fade-in">
        <div class="inline-flex items-center gap-2 bg-amber-100 text-amber-800 px-4 py-2 rounded-full text-sm font-semibold mb-4">
          <span class="material-icons text-lg">local_fire_department</span>
          <span>Popüler Seçimler</span>
        </div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
          Çok Satan <span class="brand-text">Ürünlerimiz</span>
        </h2>
        <p class="text-base md:text-lg text-gray-600 max-w-2xl mx-auto">
          Müşterilerimizin en çok tercih ettiği, kalite ve lezzeti bir arada sunan kahve çeşitlerimiz
        </p>
      </div>

      <!-- Bestseller Cards Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">

        <!-- Espresso Card -->
        <a href="/shop.html?category=espresso" class="bestseller-card fade-in">
          <div class="bestseller-card-image">
            <Image src={assetImage('images/coffees/espresso.webp')} alt="Espresso Kahve - Yoğun ve kremsi espresso içecekleri" width={800} loading="lazy" />
          </div>
          <div class="bestseller-card-overlay"></div>
          <div class="bestseller-card-content">
            <div class="bestseller-card-badge">
              <span class="material-icons text-sm">star</span>
              <span>En Çok Satan</span>
            </div>
            <h3 class="bestseller-card-title">Espresso</h3>
            <p class="bestseller-card-description">
