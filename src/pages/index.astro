---
import Base from '../layouts/Base.astro';
import UrunKarti from '../components/UrunKarti.astro';
import Lightbox from '../components/Lightbox.astro';
import Ikon from '../components/Ikon.astro';
import Buton from '../components/Buton.astro';
import { Image } from 'astro:assets';
import { assetImage } from '../data/product-images.js';
import { homeSliders } from '../data/home-sliders.js';
import { products } from '../data/products.js';

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Kervan Kuru Kahvecisi',
  url: 'https://kervankahve.com',
  logo: 'https://kervankahve.com/og-image.jpg',
  image: 'https://kervankahve.com/og-image.jpg',
  description:
    'Mersin merkezli toptan kafe ve restoran tedarikçisi. Kahve, şurup, püre, hazır tatlı, bitki çayı ve ekipman — tek tedarikçiden.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Cami Şerif, İstiklal Cd. 26-1',
    addressLocality: 'Akdeniz',
    addressRegion: 'Mersin',
    postalCode: '33060',
    addressCountry: 'TR',
  },
  telephone: '+905453207713',
  email: 'info@kervankahve.com',
  foundingDate: '2015',
  sameAs: ['https://www.instagram.com/kervankahvetr/'],
};

// Kategoriler tek yerde tanımlı; hem üstteki şerit hem aşağıdaki bölümler
// buradan üretiliyor. Eskiden aynı liste dört ayrı yerde elle yazılmıştı
// (masaüstü şerit ×2, mobil kategori satırı, bölüm başlıkları).
const kategoriler = [
  { anahtar: 'surup', ad: 'Şuruplar', altyazi: 'Kahvenize lezzet katın.',
    ikon: 'surup', gorsel: 'images/category-cards/syrup-banner.webp',
    kategoriParam: 'surup', seritId: 'syrups', seritAnahtar: 'syrups' },
  { anahtar: 'pure-tatlandirici', ad: 'Püre ve Tatlandırıcılar', altyazi: 'Özel formüller ve soslar.',
    ikon: 'pure', gorsel: 'images/category-cards/pure-tatlandirici-banner.webp',
    kategoriParam: 'pure-tatlandirici', seritId: 'pure', seritAnahtar: 'pure' },
  { anahtar: 'tatli', ad: 'Tatlılar', altyazi: 'Kahvenizin yanına en iyi eşlikçi.',
    ikon: 'pasta', gorsel: 'images/category-cards/sweet-banner.webp',
    kategoriParam: 'tatli', seritId: 'sweets', seritAnahtar: 'sweets' },
  { anahtar: 'kahve', ad: 'Kahveler', altyazi: 'Özenle seçilmiş çekirdekler.',
    ikon: 'kahve', gorsel: 'images/category-cards/espresso-banner.webp',
    kategoriParam: 'espresso', seritId: 'coffees', seritAnahtar: 'coffees' },
  { anahtar: 'cay', ad: 'Bitki Çayları', altyazi: 'Doğal ve aromalı bitki çayları.',
    ikon: 'cay', gorsel: 'images/category-cards/cay-banner.webp',
    kategoriParam: 'cay', seritId: 'teas', seritAnahtar: 'teas' },
  { anahtar: 'aksesuar', ad: 'Ekipmanlar', altyazi: 'Profesyonel ekipmanlar.',
    ikon: 'ekipman', gorsel: 'images/category-cards/aksesuar-banner.webp',
    kategoriParam: 'aksesuar', seritId: 'accessories', seritAnahtar: 'accessories' },
];

// Yük manifestosu: gerçek envanter sayıları. Süs değil, sayfanın işi bu —
//"her şeyi tek tedarikçiden alabilirsin" iddiasının kanıtı.
const kategoriSayilari = {
  espresso: 0, surup: 0, 'pure-tatlandirici': 0, tatli: 0, cay: 0, aksesuar: 0,
};
for (const u of products) {
  if (u.category in kategoriSayilari) kategoriSayilari[u.category] += 1;
}
const manifesto = kategoriler.map((k) => ({
  ad: k.ad,
  adet: kategoriSayilari[k.kategoriParam],
  href: `/shop.html?category=${k.kategoriParam}`,
}));

// İş ortakları. Logo dosyaları şeffaf payından kırpıldı (bkz. _orijinal/),
// bu yüzden artık tuval payı telafisi gerekmiyor. `yukseklik` optik dengeleme:
// eşit yükseklik geniş wordmark'ları (HARIO) baskın gösteriyor, eşit alan ise
// kare logoları (D'ORO) devleştiriyor. Değerler 56/√oran, 24–44 arasına sıkışık.
const isOrtaklari = [
  { ad: 'DaVinci Gourmet', dosya: 'davinci.png', yukseklik: 36 },
  { ad: 'Gusse', dosya: 'gusse.png', yukseklik: 28 },
  { ad: 'Fo Food Products', dosya: 'fo.png', yukseklik: 43 },
  { ad: "D'ORO Cake", dosya: 'doro.png', yukseklik: 44 },
  { ad: 'La Cimbali', dosya: 'cimbali.png', yukseklik: 27 },
  { ad: 'Hario', dosya: 'hario.png', yukseklik: 27 },
];

// Öne çıkan üç kahve. Eskiden üçü de aynı adrese gidiyordu
// (/shop.html?category=espresso); artık her biri kendi aramasına gidiyor.
const oneCikanKahveler = [
  { ad: 'Espresso', gorsel: 'images/coffees/espresso.webp',
    aciklama: 'Yoğun aroma, kremsi doku. Profesyonel barista kalitesi.',
    href: '/shop.html?search=espresso' },
  { ad: 'Filtre Kahve', gorsel: 'images/coffees/filtre-kahve.webp',
    aciklama: 'Dengeli ve aromatik profil. Sabah servisinin vazgeçilmezi.',
    href: '/shop.html?search=filtre' },
  { ad: 'Türk Kahvesi', gorsel: 'images/coffees/turk-kahvesi.webp',
    aciklama: 'Geleneksel öğütüm, zengin tat ve koku.',
    href: '/shop.html?search=türk' },
];

const destekKalemleri = [
  { ikon: 'kahve', baslik: 'Özel karışım',
    metin: 'Menünüze ve müşteri profilinize göre kavrum ve harman ayarı.' },
  { ikon: 'is', baslik: 'Barista eğitimi',
    metin: 'Personelinize ürün kullanımı ve temel kahve hazırlama eğitimi.' },
  { ikon: 'ekipman', baslik: 'Ekipman ve servis',
    metin: 'Makine seçiminde danışmanlık, kurulum ve düzenli bakım.' },
];
---

<Base
  title="Kervan Kahve — Kafe ve restoranlara toptan tedarik"
  description="Mersin merkezli toptan tedarikçi. Kahve, şurup, püre, hazır tatlı, bitki çayı ve ekipman — 100'den fazla işletme tek tedarikçiden alıyor."
  activePage="index"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(localBusiness)} />

  <Lightbox />

  <!-- ==================================================================
       Hero — sayfanın işi: işletmeyi iş ortağı yapmak.
       Kahraman bir stok fotoğraf değil, yükün genişliği.
       =================================================================== -->
  <section class="koyu-zemin bg-kavurma text-krem">
    <div class="container mx-auto px-4 md:px-6 py-10 md:py-12">
      <div class="grid lg:grid-cols-[1.1fr_1fr] gap-10 lg:gap-16 items-center">
        <div>
          <h1 class="text-buyuk text-krem">
            Bir kafenin ihtiyacı olan her şey, tek tedarikçiden.
          </h1>
          <p class="mt-5 text-govde text-krem-ikincil max-w-okuma">
            Mersin ve çevresinde 100'den fazla işletme kahvesini, şurubunu, tatlısını
            ve ekipmanını Kervan'dan alıyor. Altı ayrı tedarikçiyle uğraşmıyorlar.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <Buton href="/ortaklik.html" variant="vurgu" boyut="buyuk">Teklif alın</Buton>
            <Buton href="/shop.html" variant="ikincil-koyu" boyut="buyuk">Ürünleri görün</Buton>
          </div>
        </div>

        <!-- Yük manifestosu -->
        <div class="border border-cizgi-koyu rounded overflow-hidden">
          <p class="px-4 py-2.5 border-b border-cizgi-koyu text-kucuk text-krem-ikincil">
            Katalogda bugün
          </p>
          <ul class="divide-y divide-cizgi-koyu">
            {manifesto.map((m) => (
              <li>
                <a href={m.href}
                   class="flex items-baseline justify-between gap-4 px-4 py-2.5 hover:bg-kabuk transition-colors">
                  <span class="text-govde text-krem">{m.ad}</span>
                  <span class="text-govde font-semibold text-altin tabular-nums">{m.adet}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- İş ortakları: iddianın kanıtı, süs değil -->
      <div class="mt-8 md:mt-10 pt-6 border-t border-cizgi-koyu">
        <p class="text-kucuk text-krem-ikincil">Bayiliğini yaptığımız markalar</p>
        <ul class="mt-4 flex flex-wrap items-center gap-x-10 gap-y-6">
          {isOrtaklari.map((o) => (
            <li class="ortak-logo" style={`height: ${o.yukseklik}px`}>
              <Image src={assetImage(`images/partnerships/${o.dosya}`)} alt={o.ad} width={400} />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ==================================================================
       Kategori şeridi — tam genişlik fotoğraf bandı
       =================================================================== -->
  <section class="kategori-serit border-y border-cizgi" aria-label="Kategoriler">
    <div class="serit-ray">
      {[0, 1].map((tekrar) => (
        <div class="flex" aria-hidden={tekrar === 1 ? 'true' : undefined}>
          {kategoriler.map((k) => (
            <a href={`#kategori-${k.anahtar}`} class="kategori-kart">
              <Image src={assetImage(k.gorsel)} alt={tekrar === 0 ? k.ad : ''} width={400} />
              <span class="kategori-perde"></span>
              <span class="kategori-etiket">
                <Ikon ad={k.ikon} boyut={20} />
                <span class="font-semibold">{k.ad}</span>
              </span>
            </a>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- ==================================================================
       Öne çıkan kahveler
       =================================================================== -->
  <section class="bg-kum py-14 md:py-20">
    <div class="container mx-auto px-4 md:px-6">
      <h2 class="text-orta text-murekkep">Kendi kavurduğumuz kahveler</h2>
      <p class="mt-3 text-govde text-is max-w-okuma">
        Çekirdeği seçiyor, Mersin'deki tesisimizde kavuruyor, öğütümünü işletmenizin
        ekipmanına göre ayarlıyoruz.
      </p>

      <div class="mt-8 grid md:grid-cols-3 gap-5">
        {oneCikanKahveler.map((k) => (
          <a href={k.href} class="kahve-kart group">
            <Image src={assetImage(k.gorsel)} alt={k.ad} width={800} loading="lazy" />
            <span class="kahve-kart-perde"></span>
            <span class="kahve-kart-govde">
              <span class="block text-alt font-bold text-krem">{k.ad}</span>
              <span class="mt-1 block text-kucuk text-krem-ikincil">{k.aciklama}</span>
              <span class="mt-4 inline-flex items-center gap-2 text-kucuk font-semibold text-altin">
                İncele <Ikon ad="ok-sag" boyut={16} />
              </span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================================================================
       Kategori şeritleri — TEK döngü.
       Eskiden bu bölüm iki kez yazılmıştı: md:hidden mobil sürümü ve
       hidden md:block masaüstü sürümü, ayrı DOM ağaçları olarak.
       =================================================================== -->
  <section class="bg-kagit py-14 md:py-20">
    <div class="container mx-auto px-4 md:px-6 space-y-12">
      {kategoriler.map((k) => (
        <div id={`kategori-${k.anahtar}`} class="scroll-mt-28">
          <div class="flex items-end justify-between gap-4 mb-4">
            <div class="flex items-center gap-3 min-w-0">
              <span class="hidden sm:flex shrink-0 w-10 h-10 rounded items-center justify-center bg-kum text-kabuk">
                <Ikon ad={k.ikon} boyut={22} />
              </span>
              <div class="min-w-0">
                <h2 class="text-alt text-murekkep">{k.ad}</h2>
                <p class="text-kucuk text-is">{k.altyazi}</p>
              </div>
            </div>
            <a href={`/shop.html?category=${k.kategoriParam}`}
               class="shrink-0 text-kucuk font-semibold text-altin-koyu hover:text-kabuk whitespace-nowrap">
              Hepsini gör
            </a>
          </div>

          <div class="serit-sarmal">
            <button type="button" id={`scroll-left-${k.seritId}`}
                    class="serit-ok serit-ok--sol" aria-label={`${k.ad}: geri kaydır`}>
              <Ikon ad="chevron-sol" boyut={20} />
            </button>
            <div id={`${k.seritId}-container`} class="flex gap-4 overflow-x-auto pb-2 no-scrollbar scroll-smooth">
              {homeSliders[k.seritAnahtar].map((u) => (
                <UrunKarti product={u} variant="serit" />
              ))}
            </div>
            <button type="button" id={`scroll-right-${k.seritId}`}
                    class="serit-ok serit-ok--sag" aria-label={`${k.ad}: ileri kaydır`}>
              <Ikon ad="chevron-sag" boyut={20} />
            </button>
          </div>
        </div>
      ))}

      <div class="pt-2">
        <Buton href="/shop.html" boyut="buyuk" ikon="ok-sag" ikonSonda>Tüm ürünleri görün</Buton>
      </div>
    </div>
  </section>

  <!-- ==================================================================
       İş ortaklığı çağrısı — sayfanın birincil işi
       =================================================================== -->
  <section class="koyu-zemin bg-kavurma text-krem py-14 md:py-20">
    <div class="container mx-auto px-4 md:px-6">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <h2 class="text-orta text-krem">Tedarikçiden fazlası</h2>
          <p class="mt-4 text-govde text-krem-ikincil max-w-okuma">
            Ürünü kapınıza bırakıp gitmiyoruz. Menünüzü kurmaktan personelinizi
            eğitmeye, makinenizin bakımına kadar aynı ekiple çalışıyorsunuz.
          </p>
          <ul class="mt-8 space-y-5">
            {destekKalemleri.map((d) => (
              <li class="flex gap-4">
                <span class="shrink-0 mt-0.5 w-6 flex justify-center text-altin"><Ikon ad={d.ikon} boyut={22} /></span>
                <div>
                  <h3 class="text-govde font-semibold text-krem">{d.baslik}</h3>
                  <p class="mt-1 text-kucuk text-krem-ikincil max-w-okuma">{d.metin}</p>
                </div>
              </li>
            ))}
          </ul>
          <Buton href="/ortaklik.html" variant="vurgu" boyut="buyuk" sinif="mt-8">
            İş ortağı olun
          </Buton>
        </div>

        <div class="rounded overflow-hidden border border-cizgi-koyu">
          <Image src={assetImage('images/tedarikci.jpeg')}
                 alt="Kervan Kahve deposunda hazırlanan işletme siparişi"
                 class="w-full h-auto object-cover" width={900} loading="lazy" />
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/lightbox.js';
  import '../scripts/category-sliders.js';
</script>

<style>
  /* ---------------- İş ortağı logoları ----------------
     Logolar 512×160 tuvale ortalanmış hâlde geliyor ve her birinin tuval
     içindeki şeffaf payı farklı (hario 93px, doro 182px). Aynı yükseklikte
     gösterildiklerinde D'ORO komşularının yarısı kadar görünüyordu. Kutu
     yüksekliğini payla ölçekleyip markaların kendisini eşitliyoruz.

     Ayrıca hepsi krem tonuna indirildi: koyu zeminde altı farklı marka rengi
     (pembe, kırmızı, siyah) paleti dağıtıyordu. Kanıt olarak duruyorlar,
     dikkat çekmeleri gerekmiyor. */
  .ortak-logo { display: flex; align-items: center; }
  .ortak-logo :global(img) {
    height: 100%;
    width: auto;
    max-width: none;
    /* Koyu zeminde altı farklı marka rengi (pembe, kırmızı, siyah) paleti
       dağıtıyordu. Kanıt olarak duruyorlar; dikkat çekmeleri gerekmiyor. */
    filter: brightness(0) invert(1);
    opacity: 0.72;
  }

  /* ---------------- Kategori şeridi ---------------- */
  .kategori-serit { overflow: hidden; background: var(--kavurma); }
  .serit-ray {
    display: flex;
    width: max-content;
    animation: serit-kay 48s linear infinite;
    will-change: transform;
  }
  .kategori-serit:hover .serit-ray { animation-play-state: paused; }
  @keyframes serit-kay {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .kategori-kart {
    position: relative;
    flex-shrink: 0;
    width: 68vw;
    border-left: 1px solid rgba(245, 239, 227, 0.18);
  }
  @media (min-width: 640px)  { .kategori-kart { width: 40vw; } }
  @media (min-width: 1024px) { .kategori-kart { width: 26vw; } }
  @media (min-width: 1280px) { .kategori-kart { width: 20vw; } }
  .kategori-kart::before { content: ''; display: block; padding-top: 42%; }
  .kategori-kart :global(img) {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .kategori-perde {
    position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(46, 29, 16, .85) 0%, rgba(46, 29, 16, .35) 70%, rgba(46, 29, 16, .1) 100%);
  }
  .kategori-etiket {
    position: absolute;
    left: 1rem; bottom: 0.85rem;
    display: flex; align-items: center; gap: 0.5rem;
    color: var(--krem);
  }

  /* ---------------- Öne çıkan kahve kartları ---------------- */
  .kahve-kart {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 6px;
    background: var(--kavurma);
    min-height: 19rem;
  }
  .kahve-kart :global(img) {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .kahve-kart:hover :global(img) { transform: scale(1.04); }
  .kahve-kart-perde {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(46, 29, 16, .95) 18%, rgba(46, 29, 16, .55) 55%, rgba(46, 29, 16, .2) 100%);
  }
  .kahve-kart-govde {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 1.25rem;
  }
  .kahve-kart-govde :global(p) { max-width: none; }

  /* ---------------- Ürün şeritleri ---------------- */
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

  .serit-sarmal { position: relative; }

  .serit-ok {
    position: absolute;
    top: 42%;
    transform: translateY(-50%);
    z-index: 10;
    width: 40px; height: 40px;
    display: none;
    align-items: center; justify-content: center;
    background: var(--kagit);
    color: var(--kabuk);
    border: 1px solid var(--cizgi);
    border-radius: 9999px;
    box-shadow: var(--golge-kart);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  /* Dar ekranda parmakla kaydırılıyor, ok gerekmiyor.
     Not: `pointer: fine` ile kapatmak cazip ama kırılgan — bazı tarayıcılar
     (ve headless Chrome) işaretçi bildirmiyor, oklar hiç görünmüyordu. */
  @media (min-width: 768px) {
    .serit-ok { display: flex; }
  }
  .serit-ok:hover { border-color: var(--kabuk); color: var(--kavurma); }
  .serit-ok:disabled { opacity: 0.35; cursor: default; }
  .serit-ok--sol { left: -14px; }
  .serit-ok--sag { right: -14px; }

  @media (prefers-reduced-motion: reduce) {
    .serit-ray { animation: none; }
    .kategori-serit { overflow-x: auto; }
  }
</style>
