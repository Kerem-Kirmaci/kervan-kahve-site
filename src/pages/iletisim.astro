---
import Base from '../layouts/Base.astro';
import Ikon from '../components/Ikon.astro';
---

<Base
  title="İletişim - Kervan Kahve"
  description="Kervan Kahve iletişim - Bize ulaşın, sorularınızı sorun. Telefon, e-posta, adres bilgileri ve Google Maps konum."
  activePage="iletisim"
>
  <section class="container mx-auto px-4 md:px-6 py-10 md:py-14">
      <div class="mb-8 md:mb-10">
          <h1 class="text-buyuk text-murekkep">Bize ulaşın</h1>
          <p class="mt-3 text-govde text-is max-w-okuma">
              Sipariş, teklif veya soru — telefonla en hızlısı. Hafta içi 09:00–18:00
              arası açığız.
          </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-start">
          <div class="bg-kagit border border-cizgi p-5 md:p-7 rounded">
              <h2 class="text-alt text-murekkep mb-5">İletişim bilgileri</h2>
              <div class="space-y-6 text-murekkep">

                  <div class="flex items-start gap-4 contact-item">
                      <Ikon ad="telefon" boyut={22} sinif="shrink-0 mt-1 text-kabuk" />
                      <div class="min-w-0">
                          <p class="text-mini text-is">Telefon</p>
                          <a href="tel:+905453207713" class="text-govde font-semibold text-murekkep hover:text-kabuk">+90 545 320 77 13</a>
                      </div>
                  </div>

                  <div class="flex items-start gap-4 contact-item">
                     <Ikon ad="eposta" boyut={22} sinif="shrink-0 mt-1 text-kabuk" />
                      <div class="min-w-0">
                          <p class="text-mini text-is">E-posta</p>
                          <a href="mailto:info@kervankahve.com" class="text-govde font-semibold text-murekkep hover:text-kabuk">info@kervankahve.com</a>
                      </div>
                  </div>

                  <div class="flex items-start gap-4 contact-item">
                      <Ikon ad="instagram" boyut={22} sinif="shrink-0 mt-1 text-kabuk" />
                      <div class="min-w-0">
                          <p class="text-mini text-is">Sosyal Medya</p>
                          <a href="https://www.instagram.com/kervankahvetr" target="_blank" rel="noopener noreferrer" class="text-govde font-semibold text-murekkep hover:text-kabuk">@kervankahvetr</a>
                      </div>
                  </div>

                  <div class="flex items-start gap-4 contact-item">
                      <Ikon ad="konum" boyut={22} sinif="shrink-0 mt-1 text-kabuk" />
                      <div class="min-w-0">
                          <p class="text-mini text-is">Adres</p>
                          <p>Cami Şerif, İstiklal Cd. 26-1,<br>33060 Akdeniz/Mersin</p>
                      </div>
                  </div>
              </div>
          </div>
          <div class="w-full h-80 md:h-96 lg:h-full rounded overflow-hidden border border-cizgi">
              <!-- Harita tıklanınca yükleniyor. Gömülü Google Maps çerçevesi tek
                   başına ~1,7 MB JavaScript getiriyor ve sayfayı açan herkese
                   iniyordu; loading="lazy" masaüstünde görüş alanında kaldığı
                   için işe yaramıyordu. -->
              <div id="map-embed" class="map-facade">
                  <Ikon ad="konum" boyut={40} sinif="map-facade-pin" />
                  <p class="map-facade-adres">Cami Şerif, İstiklal Cd. 26-1<br>33060 Akdeniz/Mersin</p>
                  <button type="button" id="map-load" class="map-facade-cta">Haritayı göster</button>
                  <a
                      href="https://www.google.com/maps/dir/?api=1&destination=36.8581680%2C34.6293883"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="map-facade-link">Yol tarifi al</a>
                  <p class="map-facade-not">Haritayı açtığınızda Google Haritalar yüklenir.</p>
              </div>
              <template id="map-template">
                  <iframe
                      title="Kervan Kahve konumu — Cami Şerif, İstiklal Cd. 26-1, Akdeniz/Mersin"
                      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3192.343493921354!2d34.629388315281!3d36.8581679799365!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x1527f4d1c9031737%3A0x133a84944f378946!2zQ2FtaSDFn2VyaWYsIMSwc3Rpa2xhbCBDZC4gMjYtMSwgMzMwNjAgQWtkZW5pei9NZXJzaW4!5e0!3m2!1str!2str!4v1672521600001"
                      width="100%"
                      height="100%"
                      style="border:0;"
                      allowfullscreen=""
                      referrerpolicy="no-referrer-when-downgrade"></iframe>
              </template>
          </div>
      </div>
  </section>
  <script>
    import '../scripts/map-embed.js';
  </script>
</Base>

<style>
  /* Harita cephesi — gerçek harita yüklenene kadar duran yer tutucu */
  .map-facade {
    width: 100%;
    height: 100%;
    min-height: 20rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 2rem 1.5rem;
    text-align: center;
    background-color: var(--kum);
    background-image: linear-gradient(var(--cizgi) 1px, transparent 1px),
      linear-gradient(90deg, var(--cizgi) 1px, transparent 1px);
    background-size: 2.5rem 2.5rem;
  }

  .map-facade-pin {
    width: 2.5rem;
    height: 2.5rem;
    color: var(--kabuk);
  }

  .map-facade-adres {
    font-weight: 600;
    color: var(--murekkep);
    line-height: 1.5;
    margin: 0;
  }

  .map-facade-cta {
    background: var(--kabuk);
    color: var(--kagit);
    font-weight: 600;
    padding: 0.6rem 1.5rem;
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    transition: filter 0.2s ease, transform 0.2s ease;
  }

  .map-facade-cta:hover { filter: brightness(1.08); transform: translateY(-1px); }

  .map-facade-cta:focus-visible,
  .map-facade-link:focus-visible {
    outline: 2px solid var(--kabuk);
    outline-offset: 3px;
  }

  .map-facade-link {
    font-size: 0.9rem;
    color: var(--is);
    text-decoration: underline;
  }

  .map-facade-link:hover { color: var(--kabuk); }

  .map-facade-not {
    font-size: 0.75rem;
    color: var(--is);
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .map-facade-cta { transition: none; }
    .map-facade-cta:hover { transform: none; }
  }
</style>
