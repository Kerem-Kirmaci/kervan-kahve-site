---
import Base from '../layouts/Base.astro';
import Ikon from '../components/Ikon.astro';
import Buton from '../components/Buton.astro';

// Sayfanın işi: ziyaretçiyi en kısa yoldan bir kanala yönlendirmek. Bu yüzden
// dört kanal üstte, her biri tıklanabilir bir kart. Gömülü Google Maps
// çerçevesi kaldırıldı — tek başına ~1,7 MB getiriyordu ve ekranın yarısını
// boş bir "haritayı göster" kutusuna veriyordu. Yol tarifi bağlantısı aynı
// işi tek tıkla, sayfayı hiç ağırlaştırmadan görüyor.

const kanallar = [
  { ikon: 'telefon', etiket: 'Telefon', deger: '+90 545 320 77 13',
    not: 'En hızlısı. Her gün 08:00–19:00 arası açığız.',
    href: 'tel:+905453207713', yeniSekme: false },
  { ikon: 'whatsapp', etiket: 'WhatsApp', deger: 'Mesaj gönderin',
    not: 'Sipariş listesi ve fotoğraf paylaşımı için.',
    href: 'https://wa.me/905453207713', yeniSekme: true },
  { ikon: 'eposta', etiket: 'E-posta', deger: 'info@kervankahve.com',
    not: 'Teklif ve fatura yazışmaları için.',
    href: 'mailto:info@kervankahve.com', yeniSekme: false },
  { ikon: 'instagram', etiket: 'Instagram', deger: '@kervankahvetr',
    not: 'Yeni ürünler ve duyurular.',
    href: 'https://www.instagram.com/kervankahvetr', yeniSekme: true },
];

const adres = ['Cami Şerif, İstiklal Cd. 26-1', '33060 Akdeniz / Mersin'];
// Hedef, Google Haritalar'daki "KERVAN KAHVE" kaydının adı ve adresi —
// koordinat verince Google en yakın işaretli yere (bir otoparka) yapıştırıyordu.
// Eski gömülü haritadan miras kalan 36.858/34.629 koordinatı ise altı
// kilometre kuzeyde bir mezarlığa düşüyordu. Kaydın gerçek konumu 36.7994, 34.6283.
const yolTarifi = 'https://www.google.com/maps/dir/?api=1&destination=KERVAN+KAHVE%2C+Cami+%C5%9Eerif%2C+%C4%B0stiklal+Cd.+26-1%2C+33060+Akdeniz%2FMersin';
const haritadaGor = 'https://www.google.com/maps/search/?api=1&query=KERVAN+KAHVE+%C4%B0stiklal+Cd.+26-1+Cami+%C5%9Eerif+Akdeniz+Mersin';
---

<Base
  title="İletişim — Kervan Kahve"
  description="Kervan Kahve iletişim - Telefon, WhatsApp, e-posta ve Instagram. Mersin Akdeniz'deki kafemizin adresi, çalışma saatleri ve yol tarifi."
  activePage="iletisim"
>
  <!-- ==================================================================
       Kanallar — dört tıklanabilir kart
       =================================================================== -->
  <section class="container mx-auto px-4 md:px-6 py-10 md:py-14">
    <h1 class="text-buyuk text-murekkep">Bize ulaşın</h1>
    <p class="mt-3 text-govde text-is max-w-okuma">
      Sipariş, teklif veya soru için size en uygun kanalı seçin.
      Telefon ve WhatsApp'a mesai saatlerinde hemen dönüyoruz.
    </p>

    <ul class="mt-8 md:mt-10 grid sm:grid-cols-2 xl:grid-cols-4 gap-4">
      {kanallar.map((k) => (
        <li>
          <a
            href={k.href}
            class="kanal-karti group flex h-full flex-col rounded border border-cizgi bg-kagit p-5 transition-colors hover:border-kabuk"
            {...k.yeniSekme ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
          >
            <span class="inline-flex w-fit rounded-tam border border-cizgi bg-kum p-2.5 text-kabuk">
              <Ikon ad={k.ikon} boyut={22} />
            </span>
            <span class="mt-4 text-mini text-is">{k.etiket}</span>
            <span class="mt-1 text-govde font-semibold text-murekkep group-hover:text-kabuk [overflow-wrap:anywhere]">
              {k.deger}
            </span>
            <span class="mt-2 text-kucuk text-is">{k.not}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ==================================================================
       Kafe — adres, saatler, yol tarifi
       =================================================================== -->
  <section class="bg-kagit border-y border-cizgi py-14 md:py-20">
    <div class="container mx-auto px-4 md:px-6">
      <div class="grid lg:grid-cols-[1.1fr_1fr] gap-10 lg:gap-14 items-start">
        <div>
          <h2 class="text-orta text-murekkep">Kafemize uğrayın</h2>
          <p class="mt-4 text-govde text-is max-w-okuma">
            Mersin'in merkezinde, İstiklal Caddesi'ndeki kafemiz her gün açık.
            Kahvenizi yerinde için ya da yanınıza alın; kiloyla Türk kahvesi,
            filtre kahve ve çaylarımız paketli olarak tezgâhta.
          </p>

          <dl class="mt-8 grid sm:grid-cols-2 gap-6 max-w-okuma">
            <div>
              <dt class="text-mini text-is">Adres</dt>
              <dd class="mt-1 text-govde font-semibold text-murekkep">
                {adres[0]}<br />{adres[1]}
              </dd>
            </div>
            <div>
              <dt class="text-mini text-is">Çalışma saatleri</dt>
              <dd class="mt-1 text-govde font-semibold text-murekkep">
                Her gün 08:00–19:00
              </dd>
            </div>
          </dl>

          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <Buton href={yolTarifi} ikon="konum" yeniSekme>Yol tarifi al</Buton>
            <Buton href={haritadaGor} variant="ikincil" yeniSekme>Haritada gör</Buton>
          </div>
        </div>

        <!-- Adres kartı — koyu zeminde, kartvizit gibi -->
        <div class="koyu-zemin rounded bg-kavurma text-krem p-6 md:p-8">
          <div class="flex items-start gap-4">
            <span class="shrink-0 text-krem-ikincil"><Ikon ad="konum" boyut={28} /></span>
            <div>
              <p class="text-kucuk text-krem-ikincil">Kervan Kahve · Kafe</p>
              <p class="mt-1 text-alt font-semibold leading-snug text-krem">
                {adres[0]}<br />{adres[1]}
              </p>
            </div>
          </div>

          <div class="mt-6 border-t border-cizgi-koyu pt-6 grid grid-cols-[auto_1fr] gap-x-4 gap-y-3 text-kucuk">
            <span class="text-krem-ikincil">Telefon</span>
            <a href="tel:+905453207713" class="font-semibold text-krem hover:underline">+90 545 320 77 13</a>
            <span class="text-krem-ikincil">E-posta</span>
            <a href="mailto:info@kervankahve.com" class="font-semibold text-krem hover:underline [overflow-wrap:anywhere]">info@kervankahve.com</a>
            <span class="text-krem-ikincil">Saatler</span>
            <span class="text-krem">Her gün 08:00–19:00</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================================================================
       İşletmeler — teklif sayfasına köprü
       =================================================================== -->
  <section class="koyu-zemin bg-kavurma text-krem py-14 md:py-20">
    <div class="container mx-auto px-4 md:px-6">
      <div class="grid lg:grid-cols-[1.4fr_1fr] gap-8 items-end">
        <div>
          <h2 class="text-orta text-krem">Bir işletme için mi yazıyorsunuz?</h2>
          <p class="mt-4 text-govde text-krem-ikincil max-w-okuma">
            Kafe, restoran ve oteller için kahve, şurup, tatlı ve ekipmanı tek
            faturada tedarik ediyoruz. Menünüzü anlatın, hacminize göre fiyat çıkaralım.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row lg:justify-end gap-3">
          <Buton href="/ortaklik.html" variant="vurgu" boyut="buyuk">Teklif isteyin</Buton>
          <Buton href="/shop.html" variant="ikincil-koyu" boyut="buyuk">Ürünlere bakın</Buton>
        </div>
      </div>
    </div>
  </section>
</Base>
