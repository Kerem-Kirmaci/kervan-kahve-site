---
import Base from '../layouts/Base.astro';
import { Image, getImage } from 'astro:assets';
import heroSrc from '../assets/images/about_us/hero-hakkimizda.webp';
import hikayemizImg from '../assets/images/about_us/hikayemiz.webp';
import farkimizImg from '../assets/images/about_us/farkimiz.webp';

// Hero CSS arka planı olarak kullanılıyor; <Image> devreye giremediği için
// optimize edilmiş sürümü getImage ile üretiyoruz.
const heroImg = await getImage({ src: heroSrc, width: 1536, format: 'webp', quality: 72 });
import Buton from '../components/Buton.astro';
import Ikon from '../components/Ikon.astro';
import { products } from '../data/products.js';

// Sayılar veriden hesaplanıyor, elle yazılmıyor. Sayfada "9 yıllık deneyim"
// ve "50+ farklı ürün" yazıyordu; ilki iki yıl eskimişti, ikincisi kataloğun
// yarısını saklıyordu (100 ürün var). Elle yazılan sayı eskiyor.
const KURULUS = 2015;
const yil = new Date().getFullYear() - KURULUS;
const urunSayisi = products.length;

// Sayfanın iddiası dağıtım üzerine kurulu; kavurma o çerçevenin içinde
// "salt aracı değiliz" diyen madde, sayfanın konusu değil.
// Öncesindeki dört maddeden biri silindi: "Sürdürülebilir Tedarik" adil
// ticaret iddiası taşıyordu ve sertifika yok.
const farklar = [
  { ikon: 'canta', baslik: 'Tek elden tedarik',
    metin: 'Kahve, şurup, püre, tatlı, bitki çayı ve ekipman aynı listede, aynı faturada. Altı ayrı tedarikçiyle uğraşmazsınız.' },
  { ikon: 'kahve', baslik: 'Kahveyi kendimiz kavuruyoruz',
    metin: "Çekirdeği Brezilya başta olmak üzere Güney Amerika'dan getiriyor, kendimiz kavuruyor, harmanı menünüze ve müşteri profilinize göre ayarlıyoruz." },
  { ikon: 'konum', baslik: 'Mersin içinde kendi aracımızla',
    metin: 'Siparişinizi kargoya vermiyoruz; şehir içinde kendi aracımızla, kendimiz getiriyoruz.' },
  { ikon: 'hedef', baslik: 'Menünüze göre seçim',
    metin: 'Hangi ürünün işinize yarayacağını menünüze ve hacminize bakarak birlikte belirliyoruz.' },
  { ikon: 'is', baslik: 'Kullanım desteği',
    metin: 'Ürünlerin kullanımı ve temel hazırlık konularında personelinize destek veriyoruz.' },
];
---

<Base
  title="Hakkımızda — Kervan Kahve"
  description={`Mersin'de ${yil} yıldır kafe, restoran ve otellere tedarik yapıyoruz. Kahve, şurup, püre, tatlı, bitki çayı ve ekipman — ${urunSayisi} ürün, tek elden, kendi aracımızla.`}
  activePage="hakkimizda"
>
  {/* Hero. Eski başlık "Kahveye Olan Tutkumuz"du ve alt metni kavurmadan
      bahsediyordu. Şirketin işi kahveyle başladı ama bugün yaptığı şey
      dağıtım: kahvenin yanında şurup, püre, tatlı, çay ve ekipman da
      gidiyor. İsimde kahve geçmesi sayfanın yalnızca kahveyi anlatmasını
      gerektirmiyor. */}
  <section class="koyu-zemin relative bg-cover bg-center text-krem py-16 md:py-24 px-4 md:px-6" style={`background-image: linear-gradient(rgba(107, 69, 38, 0.8), rgba(107, 69, 38, 0.8)), url('${heroImg.src}')`}>
      <div class="container mx-auto">
          <h1 class="text-buyuk font-extrabold leading-tight">Mersin'de kurulu bir dağıtım ağı</h1>
          <p class="mt-6 text-govde md:text-alt max-w-okuma">
              {KURULUS}'te kahveyle başladık. Bugün Mersin ve çevresinde 100'den fazla kafe,
              restoran ve otele kahvenin yanında şurubunu, tatlısını ve ekipmanını da
              götürüyoruz.
          </p>
      </div>
  </section>

  <!-- Hikayemiz Section -->
  <section class="py-16 md:py-24 bg-kagit">
      <div class="container mx-auto px-4 md:px-6">
          <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
              <div class="">
                  <h2 class="text-orta text-murekkep">Hikayemiz</h2>
                  <p class="mt-6 text-govde text-is leading-relaxed">
                      Kervan Kahve {KURULUS} yılında Mersin'de kuruldu. Kurucumuz Emre Kara,
                      şehirdeki kafeleri ve restoranları gezerken tekrar eden bir sorunu fark
                      etti: işletmeler kahveyi bir yerden, şurubu başka yerden, tatlıyı bir
                      üçüncüsünden alıyor, her biriyle ayrı ayrı uğraşıyordu.
                  </p>
                  <p class="mt-4 text-govde text-is leading-relaxed">
                      Kahveyle başladık ve kahveyi hâlâ kendimiz kavuruyoruz. Ama bir kafenin
                      ihtiyacı kahveyle bitmiyordu; zamanla şurup, püre, tatlı, bitki çayı ve
                      ekipman da listeye girdi. Bugün Mersin ve çevresinde 100'den fazla
                      işletmeye tek elden tedarik yapıyoruz — siparişleri şehir içinde kendi
                      aracımızla, kendimiz götürüyoruz.
                  </p>
                  <div class="mt-8 flex flex-col sm:flex-row gap-4">
                      <Buton href="ortaklik.html">İş Ortağımız Olun</Buton>
                      <Buton href="shop.html" variant="ikincil">Ürünlerimizi Keşfedin</Buton>
                  </div>
              </div>
              <div class="">
                  <div class="rounded overflow-hidden border border-cizgi">
                      <Image src={hikayemizImg} alt="Kavurma makinesinden soğutma teknesine dökülen kavrulmuş çekirdekler; önde açık bir çuval içinde henüz kavrulmamış yeşil çekirdekler" class="w-full h-full object-cover" />
                  </div>
              </div>
          </div>
      </div>
  </section>

  <!-- Bizi Farklı Kılan Section -->
  <section class="py-16 md:py-24">
      <div class="container mx-auto px-4 md:px-6">
          <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
              <div class="">
                  <div class="rounded overflow-hidden border border-cizgi">
                      <Image src={farkimizImg} alt="Bir kafe tezgâhında yan yana duran ürünler: DaVinci Gourmet karamel ve vanilya şurupları, FO çilek şurubu, kahve torbası ve çekirdekler, espresso, çikolata sosu, dilim pasta, bitki çayı ve kahve değirmeni" class="w-full h-full object-cover" />
                  </div>
              </div>
              <div class="">
                  <h2 class="text-orta text-murekkep">Bizi Farklı Kılan Nedir?</h2>
                  <div class="mt-8 space-y-6">
                      {farklar.map((f) => (
                          <div class="flex gap-4">
                              <span class="flex-shrink-0 mt-0.5 text-kabuk"><Ikon ad={f.ikon} boyut={22} /></span>
                              <div>
                                  <h4 class="font-bold text-govde text-murekkep">{f.baslik}</h4>
                                  <p class="text-is">{f.metin}</p>
                              </div>
                          </div>
                      ))}
                  </div>
              </div>
          </div>
      </div>
  </section>

  <!-- Sayılarla Kervan Section -->
  <section class="py-16 md:py-24 bg-kagit">
      <div class="container mx-auto px-4 md:px-6">
          <h2 class="text-orta text-murekkep mb-12 md:mb-16">Sayılarla Kervan Kahve</h2>
          {/* Yıl ve ürün sayısı veriden geliyor. Elle yazıldıkları için ikisi de
              eskimişti: "9 yıllık deneyim" iki yıl geride kalmıştı, "50+ farklı
              ürün" kataloğun yarısını saklıyordu. */}
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
              <div class="">
                  <div class="text-orta font-bold text-murekkep mb-2 tabular-nums">100+</div>
                  <p class="text-is font-semibold">İş ortağımız</p>
              </div>
              <div class="">
                  <div class="text-orta font-bold text-murekkep mb-2 tabular-nums">{yil}</div>
                  <p class="text-is font-semibold">Yıllık deneyim</p>
              </div>
              <div class="">
                  <div class="text-orta font-bold text-murekkep mb-2 tabular-nums">{urunSayisi}</div>
                  <p class="text-is font-semibold">Katalogdaki ürün</p>
              </div>
              <div class="">
                  <div class="text-orta font-bold text-murekkep mb-2">Mersin</div>
                  <p class="text-is font-semibold">Hizmet bölgemiz</p>
              </div>
          </div>
      </div>
  </section>

  <!-- CTA Section -->
  <section class="koyu-zemin py-16 md:py-24 bg-kavurma text-krem">
    <div class="container mx-auto px-4 md:px-6">
      <h2 class="text-orta text-krem">Bizimle Çalışmaya Hazır Mısınız?</h2>
      <p class="mt-4 text-govde text-krem-ikincil max-w-okuma">
        İşletmenizin kahve deneyimini bir üst seviyeye taşımak için bugün bizimle iletişime geçin.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-4">
        <Buton href="ortaklik.html" variant="vurgu" boyut="buyuk">İş Ortaklığı Başvurusu</Buton>
        <Buton href="iletisim.html" variant="ikincil-koyu" boyut="buyuk">İletişime Geçin</Buton>
      </div>
    </div>
  </section>
</Base>
